-- Invoicing unit tests (build-plan row 92, F008). Every test rolls back.
-- Fixtures: the demo seed (Azure Interior, Gemini Furniture, Cable Pack 12.50 invoiced on ordered quantities, 21% sales tax).
-- Tests run without a signed-in user.

/**
 * @test Create invoice on a confirmed order makes one draft customer invoice for the quantity to invoice (2 x 12.50 + 21%)
 * @expect $Ok = true
 */
retrieve $Azure from Partners.Partner where [Name = 'Azure Interior'][not(Partners.Partner_ParentCompany/Partners.Partner)] first;
retrieve $Cable from Products.Product where [InternalReference = 'CONS_0001'] first;
$SO = call microflow Sales.SUB_SalesOrder_Create();
change $SO (Sales.SalesOrder_Customer = $Azure);
$Line = create Sales.SalesOrderLine (Quantity = 2, Sales.SalesOrderLine_SalesOrder = $SO, Sales.SalesOrderLine_Product = $Cable);
call microflow Sales.SUB_SalesOrderLine_ApplyProduct(SalesOrderLine = $Line);
commit $Line;
call microflow Sales.SUB_SalesOrder_Confirm(SalesOrder = $SO);
$Request = call microflow Invoicing.SUB_CreateInvoiceRequest_NewForOrder(SalesOrder = $SO);
$Invoices = call microflow Invoicing.SUB_SalesOrders_CreateInvoices(CreateInvoiceRequest = $Request);
$Inv = head $Invoices;
$Count = count $Invoices;
declare $Ok Boolean = $Count = 1 and $Inv/Status = Invoicing.ENUM_InvoiceStatus.Draft
  and $Inv/InvoiceType = Invoicing.ENUM_InvoiceType.CustomerInvoice and $Inv/AmountTotal = 30.25;
/

/**
 * @test A draft invoice already counts as invoiced: the order is fully invoiced (C1-08)
 * @expect $After/InvoiceStatus = Core.ENUM_InvoiceStatus.FullyInvoiced
 */
retrieve $Azure from Partners.Partner where [Name = 'Azure Interior'][not(Partners.Partner_ParentCompany/Partners.Partner)] first;
retrieve $Cable from Products.Product where [InternalReference = 'CONS_0001'] first;
$SO = call microflow Sales.SUB_SalesOrder_Create();
change $SO (Sales.SalesOrder_Customer = $Azure);
$Line = create Sales.SalesOrderLine (Quantity = 2, Sales.SalesOrderLine_SalesOrder = $SO, Sales.SalesOrderLine_Product = $Cable);
call microflow Sales.SUB_SalesOrderLine_ApplyProduct(SalesOrderLine = $Line);
commit $Line;
call microflow Sales.SUB_SalesOrder_Confirm(SalesOrder = $SO);
$Request = call microflow Invoicing.SUB_CreateInvoiceRequest_NewForOrder(SalesOrder = $SO);
$Invoices = call microflow Invoicing.SUB_SalesOrders_CreateInvoices(CreateInvoiceRequest = $Request);
$Inv = head $Invoices;
retrieve $Orders from $Inv/Invoicing.Invoice_SalesOrders;
$After = head $Orders;
/

/**
 * @test An order with nothing left to invoice is refused
 * @expect $IsValid = false
 */
retrieve $Azure from Partners.Partner where [Name = 'Azure Interior'][not(Partners.Partner_ParentCompany/Partners.Partner)] first;
retrieve $Cable from Products.Product where [InternalReference = 'CONS_0001'] first;
$SO = call microflow Sales.SUB_SalesOrder_Create();
change $SO (Sales.SalesOrder_Customer = $Azure);
$Line = create Sales.SalesOrderLine (Quantity = 2, Sales.SalesOrderLine_SalesOrder = $SO, Sales.SalesOrderLine_Product = $Cable);
call microflow Sales.SUB_SalesOrderLine_ApplyProduct(SalesOrderLine = $Line);
commit $Line;
call microflow Sales.SUB_SalesOrder_Confirm(SalesOrder = $SO);
$Request = call microflow Invoicing.SUB_CreateInvoiceRequest_NewForOrder(SalesOrder = $SO);
$Invoices = call microflow Invoicing.SUB_SalesOrders_CreateInvoices(CreateInvoiceRequest = $Request);
$Inv = head $Invoices;
$Again = call microflow Invoicing.SUB_CreateInvoiceRequest_NewForOrder(SalesOrder = $SO);
$IsValid = call microflow Invoicing.VAL_CreateInvoiceRequest(CreateInvoiceRequest = $Again);
/

/**
 * @test Posting numbers the invoice from the INV sequence and sets a due date
 * @expect $Ok = true
 */
retrieve $Azure from Partners.Partner where [Name = 'Azure Interior'][not(Partners.Partner_ParentCompany/Partners.Partner)] first;
retrieve $Cable from Products.Product where [InternalReference = 'CONS_0001'] first;
$SO = call microflow Sales.SUB_SalesOrder_Create();
change $SO (Sales.SalesOrder_Customer = $Azure);
$Line = create Sales.SalesOrderLine (Quantity = 2, Sales.SalesOrderLine_SalesOrder = $SO, Sales.SalesOrderLine_Product = $Cable);
call microflow Sales.SUB_SalesOrderLine_ApplyProduct(SalesOrderLine = $Line);
commit $Line;
call microflow Sales.SUB_SalesOrder_Confirm(SalesOrder = $SO);
$Request = call microflow Invoicing.SUB_CreateInvoiceRequest_NewForOrder(SalesOrder = $SO);
$Invoices = call microflow Invoicing.SUB_SalesOrders_CreateInvoices(CreateInvoiceRequest = $Request);
$Inv = head $Invoices;
call microflow Invoicing.SUB_Invoice_Post(Invoice = $Inv);
declare $Ok Boolean = startsWith($Inv/Number, 'INV/') and $Inv/Status = Invoicing.ENUM_InvoiceStatus.Posted and $Inv/DueDate != empty;
/

/**
 * @test A partial payment leaves the rest due and the invoice partially paid
 * @expect $Ok = true
 */
retrieve $Azure from Partners.Partner where [Name = 'Azure Interior'][not(Partners.Partner_ParentCompany/Partners.Partner)] first;
retrieve $Cable from Products.Product where [InternalReference = 'CONS_0001'] first;
$SO = call microflow Sales.SUB_SalesOrder_Create();
change $SO (Sales.SalesOrder_Customer = $Azure);
$Line = create Sales.SalesOrderLine (Quantity = 2, Sales.SalesOrderLine_SalesOrder = $SO, Sales.SalesOrderLine_Product = $Cable);
call microflow Sales.SUB_SalesOrderLine_ApplyProduct(SalesOrderLine = $Line);
commit $Line;
call microflow Sales.SUB_SalesOrder_Confirm(SalesOrder = $SO);
$Request = call microflow Invoicing.SUB_CreateInvoiceRequest_NewForOrder(SalesOrder = $SO);
$Invoices = call microflow Invoicing.SUB_SalesOrders_CreateInvoices(CreateInvoiceRequest = $Request);
$Inv = head $Invoices;
call microflow Invoicing.SUB_Invoice_Post(Invoice = $Inv);
$Pay = call microflow Invoicing.SUB_RegisterPaymentRequest_NewForInvoice(Invoice = $Inv);
change $Pay (Amount = 10);
$Payment = call microflow Invoicing.SUB_Payment_Create(RegisterPaymentRequest = $Pay);
retrieve $Fresh from Invoicing.Invoice where [Number = $Inv/Number] first;
declare $Ok Boolean = $Fresh/AmountDue = 20.25 and $Fresh/PaymentStatus = Invoicing.ENUM_PaymentStatus.PartiallyPaid;
/

/**
 * @test Paying the amount due makes the invoice paid
 * @expect $Fresh/PaymentStatus = Invoicing.ENUM_PaymentStatus.Paid
 */
retrieve $Azure from Partners.Partner where [Name = 'Azure Interior'][not(Partners.Partner_ParentCompany/Partners.Partner)] first;
retrieve $Cable from Products.Product where [InternalReference = 'CONS_0001'] first;
$SO = call microflow Sales.SUB_SalesOrder_Create();
change $SO (Sales.SalesOrder_Customer = $Azure);
$Line = create Sales.SalesOrderLine (Quantity = 2, Sales.SalesOrderLine_SalesOrder = $SO, Sales.SalesOrderLine_Product = $Cable);
call microflow Sales.SUB_SalesOrderLine_ApplyProduct(SalesOrderLine = $Line);
commit $Line;
call microflow Sales.SUB_SalesOrder_Confirm(SalesOrder = $SO);
$Request = call microflow Invoicing.SUB_CreateInvoiceRequest_NewForOrder(SalesOrder = $SO);
$Invoices = call microflow Invoicing.SUB_SalesOrders_CreateInvoices(CreateInvoiceRequest = $Request);
$Inv = head $Invoices;
call microflow Invoicing.SUB_Invoice_Post(Invoice = $Inv);
$Pay = call microflow Invoicing.SUB_RegisterPaymentRequest_NewForInvoice(Invoice = $Inv);
change $Pay (Amount = 30.25);
$Payment = call microflow Invoicing.SUB_Payment_Create(RegisterPaymentRequest = $Pay);
retrieve $Fresh from Invoicing.Invoice where [Number = $Inv/Number] first;
/

