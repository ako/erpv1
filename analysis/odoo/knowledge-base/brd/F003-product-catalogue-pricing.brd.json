 "useCases": [
  {
   "id": "UC001",
   "title": "Create a product",
   "actors": [
    "SalesManager",
    "PurchaseManager",
    "InventoryManager"
   ],
   "preconditions": [
    "Categories and units exist"
   ],
   "postconditions": [
    "Product sellable/purchasable as flagged"
   ],
   "mainFlow": [
    "1. User opens Products and clicks New",
    "2. Enters name, internal reference, type (Goods/Service), Track inventory flag",
    "3. Sets sales price, cost, units, category, customer and vendor taxes, invoicing and bill policies",
    "4. Optionally uploads a picture",
    "5. System validates and saves"
   ],
   "alternativeFlows": [],
   "screens": [
    "Product_Overview",
    "Product_NewEdit"
   ],
   "odooRefs": [
    "product.product_template_form_view",
    "product.product_template_tree_view",
    "product.template._check_uom"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending"
  },
  {
   "id": "UC002",
   "title": "Record vendor prices",
   "actors": [
    "PurchaseManager",
    "Purchaser"
   ],
   "preconditions": [
    "Product and vendor exist"
   ],
   "postconditions": [
    "RFQ lines default to this price and lead time"
   ],
   "mainFlow": [
    "1. On the product Purchase tab, user adds a vendor line: vendor, min quantity, price, discount, lead time, validity",
    "2. System uses the first valid line (sequence, min qty, dates) when a purchase line is created"
   ],
   "alternativeFlows": [],
   "screens": [
    "Product_NewEdit"
   ],
   "odooRefs": [
    "product.product_supplierinfo_form_view",
    "product.product._select_seller"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending"
  },
  {
   "id": "UC003",
   "title": "Maintain a pricelist",
   "actors": [
    "SalesManager"
   ],
   "preconditions": [
    "Products exist"
   ],
   "postconditions": [
    "Customers on this pricelist get its prices"
   ],
   "mainFlow": [
    "1. User opens Pricelists and creates one",
    "2. Adds rules: applies to all / a category / a product, fixed price or % discount, min quantity, validity",
    "3. Assigns the pricelist to customers (partner form)"
   ],
   "alternativeFlows": [],
   "screens": [
    "Pricelist_Overview",
    "Pricelist_NewEdit"
   ],
   "odooRefs": [
    "product.product_pricelist_view",
    "product.pricelist._compute_price_rule"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending"
  },
  {
   "id": "UC004",
   "title": "Get the price for a customer",
   "actors": [
    "SalesUser"
   ],
   "preconditions": [
    "Order has a pricelist"
   ],
   "postconditions": [
    "Line unit price set"
   ],
   "mainFlow": [
    "1. When a product/quantity is set on a sales line, system finds the best rule: product rule, else category (incl. parents), else global",
    "2. Rule must match min quantity and date window",
    "3. Fixed price -> price; Discount -> sales price * (1 - %)",
    "4. No rule -> product sales price"
   ],
   "alternativeFlows": [],
   "screens": [],
   "odooRefs": [
    "product.pricelist._compute_price_rule",
    "product.pricelist.item._compute_price",
    "product.pricelist.item._is_applicable_for"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending"
  },
  {
   "id": "UC005",
   "title": "Archive a product",
   "actors": [
    "SalesManager",
    "InventoryManager"
   ],
   "preconditions": [
    "Product exists"
   ],
   "postconditions": [
    "Product hidden from pickers"
   ],
   "mainFlow": [
    "1. User archives the product; documents keep the reference"
   ],
   "alternativeFlows": [],
   "screens": [
    "Product_NewEdit"
   ],
   "odooRefs": [
    "product.product_template_form_view"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending"
  }
