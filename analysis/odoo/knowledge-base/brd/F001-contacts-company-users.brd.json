 "useCases": [
  {
   "id": "UC001",
   "title": "Maintain a company contact",
   "actors": [
    "SalesUser",
    "Purchaser",
    "Billing"
   ],
   "preconditions": [
    "User has a sales, purchase or billing role"
   ],
   "postconditions": [
    "Partner saved; visible in customer/vendor pickers"
   ],
   "mainFlow": [
    "1. User opens Contacts and clicks New",
    "2. User chooses Company or Individual and enters name, address, email, phone, VAT",
    "3. User marks it as Customer and/or Vendor, sets tags, salesperson, payment terms and pricelist",
    "4. System validates the email format and that a name is given",
    "5. System saves the partner"
   ],
   "alternativeFlows": [
    "3a. VAT number already used by another partner: system warns (same_vat_partner_id), save still allowed"
   ],
   "screens": [
    "Partner_Overview",
    "Partner_NewEdit"
   ],
   "odooRefs": [
    "base.view_partner_form",
    "base.view_partner_tree",
    "res.partner.create"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/partner-overview",
    "#/partner-new-edit"
   ]
  },
  {
   "id": "UC002",
   "title": "Add a contact person or address to a company",
   "actors": [
    "SalesUser",
    "Purchaser",
    "Billing"
   ],
   "preconditions": [
    "A company partner exists"
   ],
   "postconditions": [
    "Child partner linked to the company"
   ],
   "mainFlow": [
    "1. On the company form user adds a line under Contacts & Addresses",
    "2. User picks the type: Contact, Invoice address, Delivery address or Other",
    "3. User enters name and (for addresses) the address",
    "4. System links the child to the company (Partner_ParentCompany)"
   ],
   "alternativeFlows": [],
   "screens": [
    "Partner_NewEdit",
    "PartnerChild_NewEdit"
   ],
   "odooRefs": [
    "res.partner._compute_commercial_partner"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/partner-new-edit",
    "#/partner-child-new-edit"
   ]
  },
  {
   "id": "UC003",
   "title": "Archive a partner",
   "actors": [
    "SalesManager",
    "Administrator"
   ],
   "preconditions": [
    "Partner exists"
   ],
   "postconditions": [
    "Partner hidden from pickers, history kept"
   ],
   "mainFlow": [
    "1. User opens the partner and clicks Archive",
    "2. System sets Active = false; existing documents keep their reference"
   ],
   "alternativeFlows": [
    "Archiving is the generic ORM toggle_active (odoo/models.py, framework, not imported)"
   ],
   "screens": [
    "Partner_NewEdit"
   ],
   "odooRefs": [
    "base.view_partner_form"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/partner-new-edit"
   ]
  },
  {
   "id": "UC004",
   "title": "Configure the company",
   "actors": [
    "Administrator"
   ],
   "preconditions": [
    "App installed"
   ],
   "postconditions": [
    "Company defaults used by all documents"
   ],
   "mainFlow": [
    "1. Administrator opens Settings > Company",
    "2. Enters name, address, VAT, currency, default sales/purchase tax",
    "3. Sets quotation validity days, PO approval (on/off + threshold) and purchase lead days",
    "4. System saves the singleton"
   ],
   "alternativeFlows": [],
   "screens": [
    "Company_Edit"
   ],
   "odooRefs": [
    "base.view_company_form",
    "res.company.write"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/company-edit"
   ]
  },
  {
   "id": "UC005",
   "title": "Manage app users",
   "actors": [
    "Administrator"
   ],
   "preconditions": [
    "Administrator logged in"
   ],
   "postconditions": [
    "User can log in with the given roles"
   ],
   "mainFlow": [
    "1. Administrator creates a Mendix account (Administration module) and assigns user roles",
    "2. System creates the Partners.UserProfile with display name and links it to a partner (created if missing)",
    "3. Optionally sets the default sales team"
   ],
   "alternativeFlows": [],
   "screens": [
    "Account_Overview",
    "UserProfile_Edit"
   ],
   "odooRefs": [
    "base.view_users_form",
    "res.users.create"
   ],
   "status": "proposed",
   "reviewStatus": "pending",
   "signOff": "Q-F001-3",
   "routes": [
    "#/user-profile-edit"
   ]
  },
  {
   "id": "UC006",
   "title": "Maintain document numbering",
   "actors": [
    "Administrator"
   ],
   "preconditions": [
    "Sequences seeded at startup"
   ],
   "postconditions": [
    "Next documents use the new prefix/number"
   ],
   "mainFlow": [
    "1. Administrator opens Settings > Numbering",
    "2. Edits prefix, padding or next number of a sequence"
   ],
   "alternativeFlows": [],
   "screens": [
    "Sequence_Overview"
   ],
   "odooRefs": [
    "base.ir_sequence_form"
   ],
   "status": "proposed",
   "reviewStatus": "pending",
   "signOff": "Q-F001-3",
   "routes": [
    "#/sequence-overview"
   ]
  }
