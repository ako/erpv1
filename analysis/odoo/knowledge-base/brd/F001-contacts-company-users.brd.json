 ],
 "capability": "C1",
 "summary": "One address book for customers, vendors and their contact persons/addresses; the single company record with its defaults; app users with a business profile; document numbering.",
 "provenance": "code-extracted",
 "generatedAt": "2026-10-14",
 "design": "Odoo-inspired, Mendix-native (intake Q3): Odoo is the functional reference; simplifications listed and signed off at the Stage 2 gate",
 "actorRoleMapping": {
  "SalesUser": [
   "sales_team.group_sale_salesman"
  ],
  "SalesManager": [
   "sales_team.group_sale_manager",
