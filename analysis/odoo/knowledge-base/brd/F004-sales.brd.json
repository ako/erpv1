  ]
 },
 "useCases": [
  {
   "id": "UC001",
   "title": "Create a quotation",
   "actors": [
    "SalesUser"
   ],
   "preconditions": [
    "Customer and products exist"
   ],
   "postconditions": [
    "Quotation in status Quotation with number S000nn"
   ],
   "mainFlow": [
    "1. User opens Sales > Quotations > New",
    "2. Picks the customer; system fills invoice/delivery address, pricelist, payment term, salesperson, team",
    "3. Optionally picks a quotation template: system copies its lines and validity",
    "4. Adds product lines: system fills description, unit, unit price (pricelist) and taxes; user may change quantity, price, discount",
    "5. Adds section and note lines for layout",
    "6. System recomputes subtotal, tax and total on every line change",
    "7. User saves; system assigns the number"
   ],
   "alternativeFlows": [],
   "screens": [
    "SalesOrder_Overview",
    "SalesOrder_NewEdit"
   ],
   "odooRefs": [
    "sale.view_order_form",
    "sale.view_quotation_tree",
    "sale.order._onchange_partner_id",
    "sale.order.line._compute_price_unit",
    "sale.order.line._compute_amount",
    "sale.order._compute_amounts"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/sales-order-overview",
    "#/sales-order-new-edit"
   ]
  },
  {
   "id": "UC002",
   "title": "Mark a quotation as sent",
   "actors": [
    "SalesUser"
   ],
   "preconditions": [
    "Quotation in status Quotation"
   ],
   "postconditions": [
    "Status QuotationSent"
   ],
   "mainFlow": [
    "1. User clicks Mark as sent (no email is sent — mail declared not implemented)",
    "2. System sets status QuotationSent"
   ],
   "alternativeFlows": [
    "1a. Odoo emails the quotation (action_quotation_send); here only the status changes"
   ],
   "screens": [
    "SalesOrder_NewEdit"
   ],
   "odooRefs": [
    "sale.order.action_quotation_sent"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/sales-order-new-edit"
   ]
  },
  {
   "id": "UC003",
   "title": "Confirm a quotation into a sales order",
   "actors": [
    "SalesUser"
   ],
   "preconditions": [
    "Status Quotation or QuotationSent",
    "At least one product line"
   ],
   "postconditions": [
    "Status SalesOrder, order date = now; delivery transfer created for goods (F007)"
   ],
   "mainFlow": [
    "1. User clicks Confirm",
    "2. System checks the status is Quotation/QuotationSent and that no line lacks a product (sections/notes excepted)",
    "3. System sets status SalesOrder and order date",
    "4. System triggers delivery creation (F007) and recomputes invoice status"
   ],
   "alternativeFlows": [],
   "screens": [
    "SalesOrder_NewEdit"
   ],
   "odooRefs": [
    "sale.order.action_confirm",
    "sale.order._action_confirm",
    "sale.order._confirmation_error_message"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/sales-order-new-edit"
   ]
  },
  {
   "id": "UC004",
   "title": "Cancel and reset a sales document",
   "actors": [
    "SalesUser"
   ],
   "preconditions": [
    "Not locked; no posted invoice"
   ],
   "postconditions": [
    "Status Cancelled (or back to Quotation)"
   ],
   "mainFlow": [
    "1. User clicks Cancel; system asks for confirmation",
    "2. System cancels open delivery transfers and sets status Cancelled",
    "3. From Cancelled, user can Set to quotation (status Quotation)"
   ],
   "alternativeFlows": [
    "1a. A posted invoice exists: cancellation refused with a message"
   ],
   "screens": [
