{
 "id": "F005",
 "title": "Purchasing: RFQs to purchase orders with approval",
 "modules": [
  "Purchasing"
 ],
 "actors": [
  "Purchaser",
  "PurchaseManager"
 ],
 "capability": "C5",
 "summary": "Create RFQs (manually or from reorder rules), price them from vendor prices, send, confirm — with a manager approval workflow above the company threshold — cancel or lock; purchase analysis.",
 "provenance": "code-extracted",
 "generatedAt": "2026-10-14",
 "design": "Odoo-inspired, Mendix-native (intake Q3): Odoo is the functional reference; simplifications listed and signed off at the Stage 2 gate",
 "actorRoleMapping": {
  "Purchaser": [
   "purchase.group_purchase_user"
  ],
  "PurchaseManager": [
   "purchase.group_purchase_manager"
  ]
 },
 "useCases": [
  {
   "id": "UC001",
   "title": "Create a request for quotation",
   "actors": [
    "Purchaser"
   ],
   "preconditions": [
    "Vendor and products exist"
   ],
   "postconditions": [
    "RFQ with number P000nn"
   ],
   "mainFlow": [
    "1. User opens Purchase > RFQs > New and picks the vendor; system fills payment term and currency",
    "2. Adds product lines: system fills description, purchase unit, vendor price (or cost) and vendor taxes, expected arrival = today + lead time",
    "3. System recomputes totals",
    "4. User saves"
   ],
   "alternativeFlows": [],
   "screens": [
    "PurchaseOrder_Overview",
    "PurchaseOrder_NewEdit"
   ],
   "odooRefs": [
    "purchase.purchase_order_form",
    "purchase.purchase_order_kpis_tree",
    "purchase.order.line._compute_price_unit_and_date_planned_and_name",
    "purchase.order._amount_all"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/purchase-order-overview",
    "#/purchase-order-new-edit"
   ]
  },
  {
   "id": "UC002",
   "title": "Mark an RFQ as sent",
   "actors": [
    "Purchaser"
   ],
   "preconditions": [
    "Status RFQ"
   ],
   "postconditions": [
    "Status RFQSent"
   ],
   "mainFlow": [
    "1. User clicks Mark as sent (no email)",
    "2. System sets RFQSent"
   ],
   "alternativeFlows": [],
   "screens": [
    "PurchaseOrder_NewEdit"
   ],
   "odooRefs": [
    "purchase.order.action_rfq_send"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/purchase-order-new-edit"
   ]
  },
  {
   "id": "UC003",
   "title": "Confirm an RFQ",
   "actors": [
    "Purchaser"
   ],
   "preconditions": [
    "Status RFQ or RFQSent"
   ],
   "postconditions": [
    "PurchaseOrder, or ToApprove when approval is needed"
   ],
   "mainFlow": [
    "1. User clicks Confirm order",
    "2. If company PO approval is on and total >= threshold and the user is not a PurchaseManager: status ToApprove and the approval workflow starts (UC004)",
    "3. Otherwise status PurchaseOrder, confirmation date = now, receipt created (F007)"
   ],
   "alternativeFlows": [],
   "screens": [
    "PurchaseOrder_NewEdit"
   ],
   "odooRefs": [
    "purchase.order.button_confirm",
    "purchase.order._approval_allowed",
    "purchase.order.button_approve",
    "purchase.order._add_supplier_to_product"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/purchase-order-new-edit"
   ]
  },
  {
   "id": "UC004",
   "title": "Approve or reject a purchase order",
   "actors": [
    "PurchaseManager"
   ],
   "preconditions": [
    "Status ToApprove; workflow task in the manager inbox"
   ],
   "postconditions": [
    "Approved: PurchaseOrder + receipt; Rejected: back to RFQ with a reason"
   ],
   "mainFlow": [
    "1. Manager opens the task from the inbox",
    "2. Reviews the order and clicks Approve or Reject (reason mandatory)",
    "3. Approve: system confirms the order (as UC003 step 3)",
    "4. Reject: system sets status RFQ and notifies the purchaser in the task history"
   ],
   "alternativeFlows": [],
   "screens": [
    "PurchaseApproval_Inbox",
    "PurchaseApproval_Task"
   ],
   "odooRefs": [
    "purchase.order.button_approve"
   ],
   "status": "proposed",
   "reviewStatus": "pending",
   "signOff": "Q-F005-1",
   "routes": [
    "#/purchase-approval-inbox",
    "#/purchase-approval-task"
   ]
  },
  {
   "id": "UC005",
   "title": "Cancel, reset or lock a purchase order",
   "actors": [
    "Purchaser",
    "PurchaseManager"
   ],
   "preconditions": [
    "No receipt done and no bill posted for cancel"
   ],
   "postconditions": [
    "Cancelled / RFQ / Locked"
   ],
   "mainFlow": [
    "1. Cancel: system cancels open receipts and sets Cancelled",
    "2. Set to draft: Cancelled -> RFQ",
    "3. Lock/Unlock: toggles Locked (Odoo state done)"
   ],
   "alternativeFlows": [
    "1a. A related bill is not draft/cancelled: refused, cancel the bill first (purchase_order.py button_cancel); a done receipt also blocks (purchase_stock)"
   ],
   "screens": [
    "PurchaseOrder_NewEdit"
   ],
   "odooRefs": [
    "purchase.order.button_cancel",
    "purchase.order.button_draft",
    "purchase.order.button_done",
    "purchase.order.button_unlock"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/purchase-order-new-edit"
   ]
  },
  {
   "id": "UC006",
   "title": "Analyse purchases",
   "actors": [
    "PurchaseManager"
   ],
   "preconditions": [
    "Orders exist"
   ],
   "postconditions": [
    "—"
   ],
   "mainFlow": [
    "1. Manager opens Reporting > Purchase: amounts and received/billed quantities per vendor/product/period"
   ],
   "alternativeFlows": [],
   "screens": [
    "PurchaseAnalysis_Report"
   ],
   "odooRefs": [
    "purchase.view_purchase_order_pivot"
   ],
   "status": "proposed",
   "reviewStatus": "pending",
   "signOff": "Q-F004-3",
   "routes": [
    "#/purchase-analysis-report"
   ]
  },
  {
   "id": "UC007",
   "title": "Record vendor prices",
   "actors": [
    "PurchaseManager",
    "Purchaser"
   ],
   "preconditions": [
    "Product and vendor exist"
   ],
   "postconditions": [
    "RFQ lines default to this price and lead time"
   ],
   "mainFlow": [
    "1. On the product Purchase tab, user adds a vendor line: vendor, min quantity, price, discount, lead time, validity",
    "2. System uses the first valid line (sequence, min qty, dates) when a purchase line is created"
   ],
   "alternativeFlows": [],
   "screens": [
    "VendorPrice_Overview"
   ],
   "odooRefs": [
    "product.product_supplierinfo_form_view",
    "product.product._select_seller"
   ],
   "status": "code-inferred",
   "reviewStatus": "pending",
   "routes": [
    "#/vendor-price-overview"
   ]
  }
