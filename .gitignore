# Mendix project
/**/node_modules/
!/javascriptsource/**/node_modules/
/*.launch
/.classpath
/.mendix-cache/
/.project
/deployment/
/javasource/*/proxies/
/javasource/system/
/modeler-merge-marker
/nativemobile/builds/
/packages/
/project-settings.user.json
/releases/
# Compiled theme output. MxBuild regenerates it on every build, so tracking it
# means a fresh clone goes dirty the first time anyone builds. (mxcli-todo #7)
/theme-cache/
*.mpr.lock
*.mpr.bak
/vendorlib/temp/
/.svn/

# MPR v2 journal files
/mprcontents/mprjournal*

# OS
.DS_Store

# mxcli
.claude/settings.local.json
mxcli
mxcli.exe
.mxcli/
# Per-machine session state (exec-approval.sh and friends) — never shared
.mxtk/

# Machine-local toolkit marker (doctor.sh preflight receipt)
/.claude/.doctor-receipt

# Machine-local tool locations (bin/doctor.sh / project-bin/_common.sh)
/.claude/toolkit.env

# Toolkit backups of files mxcli init wrote before init-project.sh replaced them — machine-local
/.mxtk-backup/
# Build product of project-bin/build-plan-status.sh --json, derived from
# architecture/build-plan.md. Regenerate on demand; never commit a stale copy.
/architecture/build-plan.json

# Machine-local toolkit marker (doctor.sh property-set check)
/.claude/.property-sets-receipt

# Machine-local toolkit marker (model-stamp.sh verification stamp)
/.claude/.model-verified
# Pre-exec model snapshots (project-bin/snapshot-mpr.sh). A full .mpr + mprcontents
# copy per exec, five kept. Never committed: it is the client model, several times over.
/.mpr-snapshots/
