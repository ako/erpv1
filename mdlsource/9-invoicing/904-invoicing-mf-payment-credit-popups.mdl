mdl 1;
-- Register payment and credit note: the popups' requests, their checks and the confirm actions (F008-UC006, F008-UC007).
-- The Open… actions that show the popups are in 907 (they need the popup pages, which need these confirm actions).

/**
 * A register-payment request for the given documents (Odoo account.payment.register defaults): the amount is everything due,
 * dated today, by bank transfer; the memo is the document's number when there is one document.
 *
 * @param $Invoices the documents to pay
 * @returns the uncommitted request
 */
create or modify microflow Invoicing.SUB_RegisterPaymentRequest_New ($Invoices: List of Invoicing.Invoice)
returns Invoicing.RegisterPaymentRequest as $Request
folder 'Payments/Microflows'
begin
  $Due = sum $Invoices by AmountDue;
  $Count = count $Invoices;
  $First = head $Invoices;
  $Request = create Invoicing.RegisterPaymentRequest (Amount = $Due, PaymentDate = [%BeginOfCurrentDay%],
    Method = Invoicing.ENUM_PaymentMethod.BankTransfer,
    Memo = if $Count = 1 and $First != empty then $First/Number else '',
    Invoicing.RegisterPaymentRequest_Invoices = $Invoices);
  return $Request;
end;

/**
 * A register-payment request for one document (Register payment on Invoice_NewEdit).
 *
 * @param $Invoice the document to pay
 * @returns the uncommitted request
 */
create or modify microflow Invoicing.SUB_RegisterPaymentRequest_NewForInvoice ($Invoice: Invoicing.Invoice)
returns Invoicing.RegisterPaymentRequest as $Request
folder 'Payments/Microflows'
begin
  $Invoices = create list of Invoicing.Invoice;
  add $Invoice to $Invoices;
  $Request = call microflow Invoicing.SUB_RegisterPaymentRequest_New(Invoices = $Invoices);
  return $Request;
end;

/**
 * "Create payment" on RegisterPayment_Popup: checked, the payment is created and allocated, the popup closes.
 *
 * @param $RegisterPaymentRequest the popup's request
 */
create or modify microflow Invoicing.ACT_RegisterPaymentRequest_Create ($RegisterPaymentRequest: Invoicing.RegisterPaymentRequest)
folder 'Payments/Microflows'
begin
  $IsValid = call microflow Invoicing.VAL_RegisterPaymentRequest(RegisterPaymentRequest = $RegisterPaymentRequest);
  if not($IsValid) then
    return;
  end if;
  $Payment = call microflow Invoicing.SUB_Payment_Create(RegisterPaymentRequest = $RegisterPaymentRequest);
  close page;
end;

/**
 * A credit-note request for a document (Odoo account.move.reversal defaults): dated today, no reason yet.
 *
 * @param $Invoice the document to reverse
 * @returns the uncommitted request
 */
create or modify microflow Invoicing.SUB_CreditNoteRequest_New ($Invoice: Invoicing.Invoice)
returns Invoicing.CreditNoteRequest as $Request
folder 'Invoices/Microflows'
begin
  $Request = create Invoicing.CreditNoteRequest (ReversalDate = [%BeginOfCurrentDay%], Invoicing.CreditNoteRequest_Invoice = $Invoice);
  return $Request;
end;

/**
 * Checks of a reversal (Odoo account.move.reversal): a posted customer invoice or vendor bill; credit notes are not reversed.
 *
 * @param $CreditNoteRequest the popup's request
 * @returns true when the credit note may be created
 */
create or modify microflow Invoicing.VAL_CreditNoteRequest ($CreditNoteRequest: Invoicing.CreditNoteRequest)
returns Boolean as $IsValid
folder 'Invoices/Microflows'
begin
  retrieve $Invoice from $CreditNoteRequest/Invoicing.CreditNoteRequest_Invoice;
  if $Invoice = empty then
    show message 'Select the document to reverse.' type Warning;
    return false;
  end if;
  if $Invoice/Status != Invoicing.ENUM_InvoiceStatus.Posted then
    show message 'Only a posted document can be reversed.' type Warning;
    return false;
  end if;
  if $Invoice/InvoiceType = Invoicing.ENUM_InvoiceType.CustomerCreditNote or $Invoice/InvoiceType = Invoicing.ENUM_InvoiceType.VendorCreditNote then
    show message 'A credit note is not reversed; reset it to draft or cancel it instead.' type Warning;
    return false;
  end if;
  return true;
end;

/**
 * The checked reversal: the draft credit note for the request's document.
 *
 * @param $CreditNoteRequest a checked request
 * @returns the draft credit note
 */
create or modify microflow Invoicing.SUB_CreditNoteRequest_Apply ($CreditNoteRequest: Invoicing.CreditNoteRequest)
returns Invoicing.Invoice as $CreditNote
folder 'Invoices/Microflows'
begin
  retrieve $Invoice from $CreditNoteRequest/Invoicing.CreditNoteRequest_Invoice;
  $CreditNote = call microflow Invoicing.SUB_Invoice_CreateCreditNote(Invoice = $Invoice, Reason = $CreditNoteRequest/Reason, ReversalDate = $CreditNoteRequest/ReversalDate);
  return $CreditNote;
end;

/**
 * "Reverse" on CreditNote_Popup (F008-UC006): checked, the draft credit note is created and opened.
 *
 * @param $CreditNoteRequest the popup's request
 */
create or modify microflow Invoicing.ACT_Invoice_CreateCreditNote ($CreditNoteRequest: Invoicing.CreditNoteRequest)
folder 'Invoices/Microflows'
begin
  $IsValid = call microflow Invoicing.VAL_CreditNoteRequest(CreditNoteRequest = $CreditNoteRequest);
  if not($IsValid) then
    return;
  end if;
  $CreditNote = call microflow Invoicing.SUB_CreditNoteRequest_Apply(CreditNoteRequest = $CreditNoteRequest);
  close page;
  show page Invoicing.Invoice_NewEdit(Invoice = $CreditNote);
end;

grant execute on microflow Invoicing.ACT_RegisterPaymentRequest_Create to Invoicing.Billing, Invoicing.Manager;
grant execute on microflow Invoicing.ACT_Invoice_CreateCreditNote to Invoicing.Billing, Invoicing.Manager;
