      }
    }
    tabpage tpCreditNotes (Caption: 'Credit notes') {
      datagrid gridCreditNotes (DataSource: database Invoicing."Invoice" where [InvoiceType = 'CustomerCreditNote' or InvoiceType = 'VendorCreditNote'] sort by "Number" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Invoicing.Invoice_NewEdit(Invoice = $currentObject), Selection: Multi) {
        controlbar {
          actionbutton btnSelRegisterpaymentCreditNotes (Caption: 'Register payment', Action: call microflow Invoicing.ACT_Invoice_RegisterPayment(InvoiceList = $gridCreditNotes))
