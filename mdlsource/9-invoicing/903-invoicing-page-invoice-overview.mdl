        column (Attribute: "InvoiceDate", Caption: 'Invoice date', WrapText: true) { datefilter fInvoiceDateCustomerInvoices }
        column (Attribute: "DueDate", Caption: 'Due date', WrapText: true) { datefilter fDueDateCustomerInvoices }
        column (Attribute: "AmountTotal", Caption: 'Amount total', Alignment: right, DynamicCellClass: 'num-right', WrapText: true) { numberfilter fAmountTotalCustomerInvoices }
