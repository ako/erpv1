      dynamictext txtTitle (Content: 'Invoices & bills', RenderMode: H1)
    }
    container ctnPageHeadActions (Class: 'page-head-actions') {
      actionbutton btnNew (Caption: 'New', Action: create object Invoicing."Invoice" then show page Invoicing.Invoice_NewEdit, ButtonStyle: Primary)
    }
  }
  tabcontainer tabsList {
    tabpage tpAll (Caption: 'All') {
      datagrid gridMain (DataSource: database Invoicing."Invoice" sort by "Number" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Invoicing.Invoice_NewEdit(Invoice = $currentObject), Selection: Multi) {
        controlbar {
