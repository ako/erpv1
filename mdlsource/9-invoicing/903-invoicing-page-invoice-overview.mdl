        column (Attribute: "Status", Caption: 'Status', WrapText: true) { dropdownfilter fStatusCustomerInvoices }
        column (Attribute: "PaymentStatus", Caption: 'Payment status', WrapText: true) { dropdownfilter fPaymentStatusCustomerInvoices }
      }
    }
    tabpage tpVendorBills (Caption: 'Vendor bills') {
      datagrid gridVendorBills (DataSource: database Invoicing."Invoice" where [InvoiceType = 'VendorBill'] sort by "Number" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Invoicing.Invoice_NewEdit(Invoice = $currentObject), Selection: Multi) {
        controlbar {
          actionbutton btnSelRegisterpaymentVendorBills (Caption: 'Register payment', Action: call microflow Invoicing.ACT_Invoice_RegisterPayment(InvoiceList = $gridVendorBills))
        }
        column (Attribute: "Number", Caption: 'Number', WrapText: true) { textfilter fNumberVendorBills }
