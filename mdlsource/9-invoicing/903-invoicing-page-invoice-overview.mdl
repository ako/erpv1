        column (Attribute: "Number", Caption: 'Number', WrapText: true) { textfilter fNumber }
        column (Attribute: Invoice_Partner/Name, Caption: 'Partner', WrapText: true)
        column (Attribute: "InvoiceDate", Caption: 'Invoice date', WrapText: true) { datefilter fInvoiceDate }
        column (Attribute: "DueDate", Caption: 'Due date', WrapText: true) { datefilter fDueDate }
        column (Attribute: "AmountTotal", Caption: 'Amount total', Alignment: right, DynamicCellClass: 'num-right', WrapText: true) { numberfilter fAmountTotal }
        column (Attribute: "AmountDue", Caption: 'Amount due', Alignment: right, DynamicCellClass: 'num-right', WrapText: true) { numberfilter fAmountDue }
        column (Attribute: "Status", Caption: 'Status', WrapText: true) { dropdownfilter fStatus }
        column (Attribute: "PaymentStatus", Caption: 'Payment status', WrapText: true) { dropdownfilter fPaymentStatus }
      }
    }
    tabpage tpCustomerInvoices (Caption: 'Customer invoices') {
      datagrid gridCustomerInvoices (DataSource: database Invoicing."Invoice" where [InvoiceType = 'CustomerInvoice'] sort by "Number" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Invoicing.Invoice_NewEdit(Invoice = $currentObject), Selection: Multi) {
        controlbar {
          actionbutton btnSelRegisterpaymentCustomerInvoices (Caption: 'Register payment', Action: call microflow Invoicing.ACT_Invoice_RegisterPayment(InvoiceList = $gridCustomerInvoices))
