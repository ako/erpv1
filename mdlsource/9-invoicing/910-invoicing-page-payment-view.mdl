mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["Payment_View"] — wireframe design/wireframes/Payment_View.html.
-- Regenerate, do not hand-edit. Reached from: row of Payment_Overview; payment row on Invoice_NewEdit.

/** The Invoice this PaymentAllocation points at (empty when it points nowhere). */
create or modify microflow Invoicing.SUB_PaymentAllocation_GetInvoice ($PaymentAllocation: Invoicing.PaymentAllocation)
returns Invoicing.Invoice as $Target
folder 'Payments/Microflows'
begin
  retrieve $Target from $PaymentAllocation/Invoicing.PaymentAllocation_Invoice;
  return $Target;
end;

/** A PaymentAllocation row on Payment_View opens its Invoice in Invoice_NewEdit. */
create or modify microflow Invoicing.ACT_PaymentAllocation_OpenInvoice ($PaymentAllocation: Invoicing.PaymentAllocation)
folder 'Payments/Microflows'
begin
  $Target = call microflow Invoicing.SUB_PaymentAllocation_GetInvoice(PaymentAllocation = $PaymentAllocation);
  if $Target = empty then
    show message 'This row is not linked to a invoice.' type Information;
    return;
  end if;
  show page Invoicing.Invoice_NewEdit(Invoice = $Target);
end;

/** Payment — Payment_View. */
create or modify page Invoicing.Payment_View folder 'Payments/Pages'
(
  Params: ( $Payment: Invoicing.Payment ),
  Title: 'Payment',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $Payment) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Payment', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Number = empty or trim($currentObject/Number) = '' then 'New' else $currentObject/Number), RenderMode: H1)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          dynamictext hPayment (Content: 'Payment', RenderMode: H2)
          combobox cmbDirection (Label: 'Direction', Attribute: "Direction", Editable: Never)
          combobox cmbPartnerKind (Label: 'Partner kind', Attribute: "PartnerKind", Editable: Never)
          combobox cmbPaymentPartner (Label: 'Partner', Attribute: Payment_Partner, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          textbox txtAmount (Label: 'Amount', Attribute: "Amount", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
          combobox cmbPaymentCurrency (Label: 'Currency', Attribute: Payment_Currency, DataSource: database Core."Currency" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          datepicker dpPaymentDate (Label: 'Payment date', Attribute: "PaymentDate", Editable: Never)
          combobox cmbMethod (Label: 'Method', Attribute: "Method", Editable: Never)
          textbox txtMemo (Label: 'Memo', Attribute: "Memo", Editable: Never)
          combobox cmbStatus (Label: 'Status', Attribute: "Status", Editable: Never)
        }
      }
    }
    dynamictext hAllocatedto (Content: 'Allocated to', RenderMode: H2)
    datagrid gridAllocatedto (DataSource: database Invoicing."PaymentAllocation" where [Invoicing.PaymentAllocation_Payment = '[%CurrentObject%]'], Class: 'density-compact', OnClick: call microflow Invoicing.ACT_PaymentAllocation_OpenInvoice(PaymentAllocation = $currentObject)) {
      column (Attribute: PaymentAllocation_Invoice/Number, Caption: 'Invoice', WrapText: true)
      column (Attribute: "Amount", Caption: 'Amount', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
    }
  }
      }
    }
  }
};

grant view on page Invoicing.Payment_View to Invoicing.Billing, Invoicing.Manager;
grant execute on microflow Invoicing.ACT_PaymentAllocation_OpenInvoice to Invoicing.Billing, Invoicing.Manager;
