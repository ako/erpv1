/** A new ReorderRule row, committed so the list shows it at once. */
create or modify microflow Inventory.SUB_ReorderRule_Add ()
returns Inventory.ReorderRule as $Row
folder 'Replenishment/Microflows'
begin
  $Row = create Inventory."ReorderRule" ();
  commit $Row refresh;
  return $Row;
end;

/** "+ Add a line" on ReorderRule_Overview. */
create or modify microflow Inventory.ACT_ReorderRule_Add ()
folder 'Replenishment/Microflows'
begin
  $Row = call microflow Inventory.SUB_ReorderRule_Add();
end;

/** Reorder rules — ReorderRule_Overview. */
create or modify page Inventory.ReorderRule_Overview folder 'Replenishment/Pages'
(
  Title: 'Reorder rules',
  Layout: Core.App_Default,
  Url: 'reorder-rule-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
    container ctnPageHeadTitle (Class: 'page-head-title') {
      dynamictext txtTitle (Content: 'Reorder rules', RenderMode: H1)
    }
    container ctnPageHeadActions (Class: 'page-head-actions') {
      actionbutton btnRunscheduler1 (Caption: 'Run scheduler', Action: call microflow Inventory.ACT_ReorderRules_RunNow, ButtonStyle: Primary)
    }
  }
  layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
    row {
      column (DesktopWidth: 2) { dynamictext hdReorderRuleProduct (Content: 'Product', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdReorderRuleLocation (Content: 'Location', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdReorderRuleVendor (Content: 'Vendor', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdMinQuantity (Content: 'Min quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdMaxQuantity (Content: 'Max quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdQuantityMultiple (Content: 'Quantity multiple', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdAutomatic (Content: 'Automatic', RenderMode: Text) }
    }
  }
  listview lvLines (DataSource: database Inventory."ReorderRule" sort by ReorderRule_Product/Name asc, Editable: true, Class: 'lines-list') {
    layoutgrid gridLine {
      row {
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbReorderRuleProduct (Label: 'Product', Attribute: ReorderRule_Product, DataSource: database Products."Product" sort by "Name" asc, CaptionAttribute: "Name", OnChange: save changes, Editable: $currentObject/Inventory.ReorderRule_Product = empty) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbReorderRuleLocation (Label: 'Location', Attribute: ReorderRule_Location, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name", OnChange: save changes, Editable: $currentObject/Inventory.ReorderRule_Location = empty) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbReorderRuleVendor (Label: 'Vendor', Attribute: ReorderRule_Vendor, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name", OnChange: save changes) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtMinQuantity (Label: 'Min quantity', Attribute: "MinQuantity", DecimalPrecision: 2, GroupDigits: true, OnChange: save changes) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtMaxQuantity (Label: 'Max quantity', Attribute: "MaxQuantity", DecimalPrecision: 2, GroupDigits: true, OnChange: save changes) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtQuantityMultiple (Label: 'Quantity multiple', Attribute: "QuantityMultiple", DecimalPrecision: 2, GroupDigits: true, OnChange: save changes) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { checkbox lncbAutomatic (Label: 'Automatic', Attribute: "Automatic", OnChange: save changes) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnRowAction (Caption: 'Order once', Action: call microflow Inventory.ACT_ReorderRule_OrderOnce(ReorderRule = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
      }
    }
  }
  linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Inventory.ACT_ReorderRule_Add)
};

grant view on page Inventory.ReorderRule_Overview to Inventory.Manager, Inventory.Reader;
grant execute on microflow Inventory.ACT_ReorderRule_Add to Inventory.Manager;
grant execute on microflow Inventory.ACT_ReorderRule_OrderOnce to Inventory.Manager;
grant execute on microflow Inventory.ACT_ReorderRules_RunNow to Inventory.Manager;
