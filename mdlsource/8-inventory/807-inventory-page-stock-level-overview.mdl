/** Stock — StockLevel_Overview. */
create or modify page Inventory.StockLevel_Overview folder 'Stock/Pages'
(
  Title: 'Stock',
  Layout: Core.App_Default,
  Url: 'stock-level-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
    container ctnPageHeadTitle (Class: 'page-head-title') {
      dynamictext txtTitle (Content: 'Stock', RenderMode: H1)
    }
  }
  layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
    row {
      column (DesktopWidth: 3) { dynamictext hdStockLevelProduct (Content: 'Product', RenderMode: Text) }
      column (DesktopWidth: 3) { dynamictext hdStockLevelLocation (Content: 'Location', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdQuantity (Content: 'Quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdReservedQuantity (Content: 'Reserved quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdCountedQuantity (Content: 'Counted quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdScheduledCountDate (Content: 'Scheduled count date', RenderMode: Text) }
    }
  }
  listview lvLines (DataSource: database Inventory."StockLevel" sort by StockLevel_Product/Name asc, Editable: true, Class: 'lines-list') {
    layoutgrid gridLine {
      row {
        column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbStockLevelProduct (Label: 'Product', Attribute: StockLevel_Product, DataSource: database Products."Product" sort by "Name" asc, CaptionAttribute: "Name", OnChange: save changes, Editable: $currentObject/Inventory.StockLevel_Product = empty) }
        column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbStockLevelLocation (Label: 'Location', Attribute: StockLevel_Location, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name", OnChange: save changes, Editable: $currentObject/Inventory.StockLevel_Location = empty) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtQuantity (Label: 'Quantity', Attribute: "Quantity", DecimalPrecision: 2, GroupDigits: true, Editable: Never) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtReservedQuantity (Label: 'Reserved quantity', Attribute: "ReservedQuantity", DecimalPrecision: 2, GroupDigits: true, Editable: Never) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtCountedQuantity (Label: 'Counted quantity', Attribute: "CountedQuantity", DecimalPrecision: 2, GroupDigits: true) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { datepicker lndpScheduledCountDate (Label: 'Scheduled count date', Attribute: "ScheduledCountDate", OnChange: save changes) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnRowAction (Caption: 'Apply', Action: call microflow Inventory.ACT_StockLevel_ApplyCount(StockLevel = $currentObject)) }
      }
    }
  }
};

grant view on page Inventory.StockLevel_Overview to Inventory.User, Inventory.Manager;
grant execute on microflow Inventory.ACT_StockLevel_ApplyCount to Inventory.User, Inventory.Manager;
