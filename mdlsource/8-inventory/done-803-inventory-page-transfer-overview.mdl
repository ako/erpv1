/** Transfers — Transfer_Overview. */
create or modify page Inventory.Transfer_Overview folder 'Operations/Pages'
(
  Title: 'Transfers',
  Layout: Core.App_Default,
  Url: 'transfer-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
    container ctnPageHeadTitle (Class: 'page-head-title') {
      dynamictext txtTitle (Content: 'Transfers', RenderMode: H1)
    }
    container ctnPageHeadActions (Class: 'page-head-actions') {
      actionbutton btnNew (Caption: 'New', Action: call microflow Inventory.ACT_Transfer_New, ButtonStyle: Primary)
    }
  }
  tabcontainer tabsList {
    tabpage tpAll (Caption: 'All') {
      datagrid gridMain (DataSource: database Inventory."Transfer" sort by "ScheduledDate" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Inventory.Transfer_NewEdit(Transfer = $currentObject)) {
        column (Attribute: "Number", Caption: 'Number', WrapText: true) { textfilter fNumber }
        column (Attribute: Transfer_Partner/Name, Caption: 'Partner', WrapText: true)
        column (Attribute: "ScheduledDate", Caption: 'Scheduled date', WrapText: true) { datefilter fScheduledDate }
        column (Attribute: "SourceDocument", Caption: 'Source document', WrapText: true) { textfilter fSourceDocument }
        column (Attribute: Transfer_OperationType/Name, Caption: 'Operation type', WrapText: true)
        column (Attribute: "Status", Caption: 'Status', WrapText: true) { dropdownfilter fStatus }
      }
    }
    tabpage tpReceipts (Caption: 'Receipts') {
      datagrid gridReceipts (DataSource: database Inventory."Transfer" where [Inventory.Transfer_OperationType/Inventory.OperationType/Kind = 'Receipt'] sort by "ScheduledDate" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Inventory.Transfer_NewEdit(Transfer = $currentObject)) {
        column (Attribute: "Number", Caption: 'Number', WrapText: true) { textfilter fNumberReceipts }
        column (Attribute: Transfer_Partner/Name, Caption: 'Partner', WrapText: true)
        column (Attribute: "ScheduledDate", Caption: 'Scheduled date', WrapText: true) { datefilter fScheduledDateReceipts }
        column (Attribute: "SourceDocument", Caption: 'Source document', WrapText: true) { textfilter fSourceDocumentReceipts }
        column (Attribute: Transfer_OperationType/Name, Caption: 'Operation type', WrapText: true)
        column (Attribute: "Status", Caption: 'Status', WrapText: true) { dropdownfilter fStatusReceipts }
      }
    }
    tabpage tpDeliveries (Caption: 'Deliveries') {
      datagrid gridDeliveries (DataSource: database Inventory."Transfer" where [Inventory.Transfer_OperationType/Inventory.OperationType/Kind = 'Delivery'] sort by "ScheduledDate" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Inventory.Transfer_NewEdit(Transfer = $currentObject)) {
        column (Attribute: "Number", Caption: 'Number', WrapText: true) { textfilter fNumberDeliveries }
        column (Attribute: Transfer_Partner/Name, Caption: 'Partner', WrapText: true)
        column (Attribute: "ScheduledDate", Caption: 'Scheduled date', WrapText: true) { datefilter fScheduledDateDeliveries }
        column (Attribute: "SourceDocument", Caption: 'Source document', WrapText: true) { textfilter fSourceDocumentDeliveries }
        column (Attribute: Transfer_OperationType/Name, Caption: 'Operation type', WrapText: true)
        column (Attribute: "Status", Caption: 'Status', WrapText: true) { dropdownfilter fStatusDeliveries }
      }
    }
    tabpage tpInternal (Caption: 'Internal') {
      datagrid gridInternal (DataSource: database Inventory."Transfer" where [Inventory.Transfer_OperationType/Inventory.OperationType/Kind = 'Internal'] sort by "ScheduledDate" desc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Inventory.Transfer_NewEdit(Transfer = $currentObject)) {
        column (Attribute: "Number", Caption: 'Number', WrapText: true) { textfilter fNumberInternal }
        column (Attribute: Transfer_Partner/Name, Caption: 'Partner', WrapText: true)
        column (Attribute: "ScheduledDate", Caption: 'Scheduled date', WrapText: true) { datefilter fScheduledDateInternal }
        column (Attribute: "SourceDocument", Caption: 'Source document', WrapText: true) { textfilter fSourceDocumentInternal }
        column (Attribute: Transfer_OperationType/Name, Caption: 'Operation type', WrapText: true)
        column (Attribute: "Status", Caption: 'Status', WrapText: true) { dropdownfilter fStatusInternal }
      }
    }
  }
};

grant view on page Inventory.Transfer_Overview to Inventory.User, Inventory.Manager;
grant execute on microflow Inventory.ACT_Transfer_New to Inventory.User, Inventory.Manager;
