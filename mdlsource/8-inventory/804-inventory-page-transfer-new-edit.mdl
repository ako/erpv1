mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["Transfer_NewEdit"] — wireframe design/wireframes/Transfer_NewEdit.html.
-- Regenerate, do not hand-edit. Reached from: row of Transfer_Overview; Delivery / Receipt smart button on SalesOrder_NewEdit / PurchaseOrder_NewEdit.

/** A new StockMove on the Transfer, committed so the line editor shows it at once. */
create or modify microflow Inventory.SUB_StockMove_Add ($Transfer: Inventory.Transfer)
returns Inventory.StockMove as $Line
folder 'Operations/Microflows'
begin
  $Line = create Inventory."StockMove" (Inventory.StockMove_Transfer = $Transfer);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on Transfer_NewEdit. */
create or modify microflow Inventory.ACT_StockMove_Add ($Transfer: Inventory.Transfer)
folder 'Operations/Microflows'
begin
  $Line = call microflow Inventory.SUB_StockMove_Add(Transfer = $Transfer);
end;

/** Transfer — Transfer_NewEdit. */
create or modify page Inventory.Transfer_NewEdit folder 'Operations/Pages'
(
  Params: ( $Transfer: Inventory.Transfer ),
  Title: 'Transfer',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $Transfer) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Transfer', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Number = empty or trim($currentObject/Number) = '' then 'New' else $currentObject/Number), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnValidate0 (Caption: 'Validate', Action: call microflow Inventory.ACT_Transfer_Validate(Transfer = $currentObject), ButtonStyle: Primary, Visible: $currentObject/Status = Inventory.ENUM_TransferStatus.Waiting or $currentObject/Status = Inventory.ENUM_TransferStatus.Ready)
        actionbutton btnMarkastodo1 (Caption: 'Mark as to do', Action: call microflow Inventory.ACT_Transfer_Confirm(Transfer = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Inventory.ENUM_TransferStatus.Draft)
        actionbutton btnCheckavailability2 (Caption: 'Check availability', Action: call microflow Inventory.ACT_Transfer_CheckAvailability(Transfer = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Inventory.ENUM_TransferStatus.Waiting)
        actionbutton btnCanceltransfer3 (Caption: 'Cancel transfer', Action: call microflow Inventory.ACT_Transfer_Cancel(Transfer = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Inventory.ENUM_TransferStatus.Draft or $currentObject/Status = Inventory.ENUM_TransferStatus.Waiting or $currentObject/Status = Inventory.ENUM_TransferStatus.Ready)
      }
    }
    dynamictext txtStatus (Content: '{1}', ContentParams: ({1} = "Status"), Class: 'pill pill-info spacing-outer-bottom-medium')
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hTransfer (Content: 'Transfer', RenderMode: H2)
          combobox cmbTransferPartner (Label: 'Partner', Attribute: Transfer_Partner, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbTransferOperationType (Label: 'Operation type', Attribute: Transfer_OperationType, DataSource: database Inventory."OperationType" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbTransferSourceLocation (Label: 'Source location', Attribute: Transfer_SourceLocation, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbTransferDestinationLocation (Label: 'Destination location', Attribute: Transfer_DestinationLocation, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hDates (Content: 'Dates', RenderMode: H2)
          datepicker dpScheduledDate (Label: 'Scheduled date', Attribute: "ScheduledDate")
          datepicker dpDeadline (Label: 'Deadline', Attribute: "Deadline")
          datepicker dpDateDone (Label: 'Date done', Attribute: "DateDone", Editable: Never)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hOrigin (Content: 'Origin', RenderMode: H2)
          textbox txtSourceDocument (Label: 'Source document', Attribute: "SourceDocument")
          combobox cmbTransferBackorder (Label: 'Backorder', Attribute: Transfer_Backorder, DataSource: database Inventory."Transfer" sort by "Number" asc, CaptionAttribute: "Number")
          combobox cmbTransferResponsible (Label: 'Responsible', Attribute: Transfer_Responsible, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName")
        }
      }
    }
    dynamictext hOperations (Content: 'Operations', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 4) { dynamictext hdStockMoveProduct (Content: 'Product', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdDemandQuantity (Content: 'Demand quantity', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdQuantity (Content: 'Quantity', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdStockMoveUoM (Content: 'Unit', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdPicked (Content: 'Picked', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdStatus (Content: 'Status', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Inventory.StockMove_Transfer, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 4, TabletWidth: 4, PhoneWidth: 12) { combobox lncmbStockMoveProduct (Label: 'Product', Attribute: StockMove_Product, DataSource: database Products."Product" sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtDemandQuantity (Label: 'Demand quantity', Attribute: "DemandQuantity", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtQuantity (Label: 'Quantity', Attribute: "Quantity", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbStockMoveUoM (Label: 'Unit', Attribute: StockMove_UoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { checkbox lncbPicked (Label: 'Picked', Attribute: "Picked") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbStatus (Label: 'Status', Attribute: "Status", Editable: Never) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Inventory.ACT_StockMove_Add(Transfer = $currentObject))
    textarea taNotes (Label: 'Notes', Attribute: "Notes")
  }
      }
    }
  }
};

grant view on page Inventory.Transfer_NewEdit to Inventory.User, Inventory.Manager, Inventory.Reader;
grant execute on microflow Inventory.ACT_StockMove_Add to Inventory.User, Inventory.Manager;
grant execute on microflow Inventory.ACT_Transfer_Cancel to Inventory.User, Inventory.Manager;
grant execute on microflow Inventory.ACT_Transfer_CheckAvailability to Inventory.User, Inventory.Manager;
grant execute on microflow Inventory.ACT_Transfer_Confirm to Inventory.User, Inventory.Manager;
grant execute on microflow Inventory.ACT_Transfer_Validate to Inventory.User, Inventory.Manager;
