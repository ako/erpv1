      dynamictext txtTitle (Content: 'Reorder rules', RenderMode: H1)
    }
    container ctnPageHeadActions (Class: 'page-head-actions') {
      actionbutton btnRunscheduler1 (Caption: 'Run scheduler', Action: call microflow Inventory.ACT_ReorderRules_RunNow, ButtonStyle: Primary)
    }
  }
  layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
    row {
      column (DesktopWidth: 2) { dynamictext hdReorderRuleProduct (Content: 'Product', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdReorderRuleLocation (Content: 'Location', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdReorderRuleVendor (Content: 'Vendor', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdMinQuantity (Content: 'Min quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdMaxQuantity (Content: 'Max quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdQuantityMultiple (Content: 'Quantity multiple', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdAutomatic (Content: 'Automatic', RenderMode: Text) }
    }
  }
  listview lvLines (DataSource: database Inventory."ReorderRule" sort by ReorderRule_Product/Name asc, Editable: true, Class: 'lines-list') {
    layoutgrid gridLine {
      row {
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbReorderRuleProduct (Label: 'Product', Attribute: ReorderRule_Product, DataSource: database Products."Product" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Inventory.ACT_ReorderRule_SaveRow(ReorderRule = $currentObject), Editable: $currentObject/Inventory.ReorderRule_Product = empty) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbReorderRuleLocation (Label: 'Location', Attribute: ReorderRule_Location, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Inventory.ACT_ReorderRule_SaveRow(ReorderRule = $currentObject), Editable: $currentObject/Inventory.ReorderRule_Location = empty) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbReorderRuleVendor (Label: 'Vendor', Attribute: ReorderRule_Vendor, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Inventory.ACT_ReorderRule_SaveRow(ReorderRule = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtMinQuantity (Label: 'Min quantity', Attribute: "MinQuantity", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Inventory.ACT_ReorderRule_SaveRow(ReorderRule = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtMaxQuantity (Label: 'Max quantity', Attribute: "MaxQuantity", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Inventory.ACT_ReorderRule_SaveRow(ReorderRule = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtQuantityMultiple (Label: 'Quantity multiple', Attribute: "QuantityMultiple", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Inventory.ACT_ReorderRule_SaveRow(ReorderRule = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { checkbox lncbAutomatic (Label: 'Automatic', Attribute: "Automatic", OnChange: call microflow Inventory.ACT_ReorderRule_SaveRow(ReorderRule = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnRowAction (Caption: 'Order once', Action: call microflow Inventory.ACT_ReorderRule_OrderOnce(ReorderRule = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
      }
    }
  }
  linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Inventory.ACT_ReorderRule_Add)
};

