/** Checks on one ReorderRule row of ReorderRule_Overview (the row saves on change). */
create or modify microflow Inventory.VAL_ReorderRule_Row ($ReorderRule: Inventory.ReorderRule)
returns Boolean as $IsValid
folder 'Replenishment/Microflows'
begin
  declare $IsValid Boolean = true;
  if $ReorderRule/MinQuantity != empty and $ReorderRule/MaxQuantity != empty and $ReorderRule/MinQuantity > $ReorderRule/MaxQuantity then
    validation feedback $ReorderRule/MinQuantity message 'The minimum quantity must be less than or equal to the maximum quantity.';
    set $IsValid = false;
  end if;
  if $ReorderRule/MinQuantity != empty and $ReorderRule/MinQuantity < 0 then
    validation feedback $ReorderRule/MinQuantity message 'The minimum quantity cannot be negative.';
    set $IsValid = false;
  end if;
  if $ReorderRule/MaxQuantity != empty and $ReorderRule/MaxQuantity < 0 then
    validation feedback $ReorderRule/MaxQuantity message 'The maximum quantity cannot be negative.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist one checked ReorderRule row. */
create or modify microflow Inventory.SUB_ReorderRule_SaveRow ($ReorderRule: Inventory.ReorderRule)
folder 'Replenishment/Microflows'
begin
  commit $ReorderRule with events refresh;
end;

/** On change of a ReorderRule row on ReorderRule_Overview: save it when its checks pass, else flag the field and keep it unsaved. */
create or modify microflow Inventory.ACT_ReorderRule_SaveRow ($ReorderRule: Inventory.ReorderRule)
folder 'Replenishment/Microflows'
begin
  $IsValid = call microflow Inventory.VAL_ReorderRule_Row(ReorderRule = $ReorderRule);
  if $IsValid then
    call microflow Inventory.SUB_ReorderRule_SaveRow(ReorderRule = $ReorderRule);
  end if;
end;

/** A new ReorderRule row, committed so the list shows it at once. */
create or modify microflow Inventory.SUB_ReorderRule_Add ()
returns Inventory.ReorderRule as $Row
folder 'Replenishment/Microflows'
begin
  $Row = create Inventory."ReorderRule" ();
  commit $Row refresh;
  return $Row;
end;

/** "+ Add a line" on ReorderRule_Overview. */
create or modify microflow Inventory.ACT_ReorderRule_Add ()
folder 'Replenishment/Microflows'
begin
  $Row = call microflow Inventory.SUB_ReorderRule_Add();
end;

/** Reorder rules — ReorderRule_Overview. */
create or modify page Inventory.ReorderRule_Overview folder 'Replenishment/Pages'
(
  Title: 'Reorder rules',
  Layout: Core.App_Default,
  Url: 'reorder-rule-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
