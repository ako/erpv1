/** Validate a UserProfile before save: every required field on UserProfile_Edit, all flagged on one submit. */
create or modify microflow Partners.VAL_UserProfile ($UserProfile: Partners.UserProfile)
returns Boolean as $IsValid
folder 'Users/Microflows'
begin
  declare $IsValid Boolean = true;
  if $UserProfile/Partners.UserProfile_Partner = empty then
    validation feedback $UserProfile/Partners.UserProfile_Partner message 'Partner is required.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated UserProfile. */
create or modify microflow Partners.SUB_UserProfile_Save ($UserProfile: Partners.UserProfile)
folder 'Users/Microflows'
begin
  commit $UserProfile with events refresh;
end;

/** Save button on UserProfile_Edit: validate, persist, close. */
create or modify microflow Partners.ACT_UserProfile_Save ($UserProfile: Partners.UserProfile)
folder 'Users/Microflows'
begin
  $IsValid = call microflow Partners.VAL_UserProfile(UserProfile = $UserProfile);
  if $IsValid then
    call microflow Partners.SUB_UserProfile_Save(UserProfile = $UserProfile);
    close page;
  end if;
end;

/** User profile — UserProfile_Edit. */
create or modify page Partners.UserProfile_Edit folder 'Users/Pages'
(
  Params: ( $UserProfile: Partners.UserProfile ),
  Title: 'User profile',
  Layout: Atlas_Core.PopupLayout
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $UserProfile) {
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          textbox ptxtDisplayName (Label: 'Display name', Attribute: "DisplayName")
          combobox pcmbUserProfilePartner (Label: 'Partner', Attribute: UserProfile_Partner, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name")
          combobox pcmbUserProfileAccount (Label: 'Account', Attribute: UserProfile_Account, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName")
        }
      }
    }
    footer {
      actionbutton pbtnSave0 (Caption: 'Save', Action: call microflow Partners.ACT_UserProfile_Save(UserProfile = $currentObject), ButtonStyle: Primary)
      actionbutton pbtnCancel (Caption: 'Cancel', Action: cancel changes close page)
    }
  }
      }
    }
  }
};

grant view on page Partners.UserProfile_Edit to Partners.Admin;
