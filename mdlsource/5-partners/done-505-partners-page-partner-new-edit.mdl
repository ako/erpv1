mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["Partner_NewEdit"] — wireframe design/wireframes/Partner_NewEdit.html.
-- Regenerate, do not hand-edit. Reached from: row of Partner_Overview; New on Partner_Overview; customer link on SalesOrder_NewEdit.

/** A new, uncommitted Partner linked to this Partner. */
create or modify microflow Partners.SUB_Partner_NewForPartner ($Partner: Partners.Partner)
returns Partners.Partner as $Child
folder 'Contacts/Microflows'
begin
  $Child = create Partners."Partner" (Partners.Partner_ParentCompany = $Partner);
  return $Child;
end;

/** "+ Add" on Partner_NewEdit: a new Partner, opened in PartnerChild_NewEdit (Save commits it, Cancel drops it). */
create or modify microflow Partners.ACT_Partner_AddToPartner ($Partner: Partners.Partner)
folder 'Contacts/Microflows'
begin
  $Child = call microflow Partners.SUB_Partner_NewForPartner(Partner = $Partner);
  show page Partners.PartnerChild_NewEdit(Partner = $Child);
end;

/** Contact — Partner_NewEdit. */
create or modify page Partners.Partner_NewEdit folder 'Contacts/Pages'
(
  Params: ( $Partner: Partners.Partner ),
  Title: 'Contact',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $Partner) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Contact', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Name = empty or trim($currentObject/Name) = '' then 'New' else $currentObject/Name), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Partners.ACT_Partner_Save(Partner = $currentObject), ButtonStyle: Primary)
        actionbutton btnArchive1 (Caption: 'Archive', Action: call microflow Partners.ACT_Partner_Archive(Partner = $currentObject), ButtonStyle: Default)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hIdentity (Content: 'Identity', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
          checkbox cbIsCompany (Label: 'Is company', Attribute: "IsCompany")
          combobox cmbPartnerParentCompany (Label: 'Parent company', Attribute: Partner_ParentCompany, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtJobPosition (Label: 'Job position', Attribute: "JobPosition")
          combobox cmbPartnerTags (Label: 'Tags', Attribute: Partner_Tags, DataSource: database Partners."PartnerTag" sort by "Name" asc, CaptionAttribute: "Name")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hAddress (Content: 'Address', RenderMode: H2)
          textbox txtStreet (Label: 'Street', Attribute: "Street")
          textbox txtStreet2 (Label: 'Street2', Attribute: "Street2")
          textbox txtZip (Label: 'Zip', Attribute: "Zip")
          textbox txtCity (Label: 'City', Attribute: "City")
          combobox cmbPartnerCountry (Label: 'Country', Attribute: Partner_Country, DataSource: database Core."Country" sort by "Name" asc, CaptionAttribute: "Name")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hContact (Content: 'Contact', RenderMode: H2)
          textbox txtEmail (Label: 'Email', Attribute: "Email")
          textbox txtPhone (Label: 'Phone', Attribute: "Phone")
          textbox txtMobile (Label: 'Mobile', Attribute: "Mobile")
          textbox txtWebsite (Label: 'Website', Attribute: "Website")
          textbox txtVATNumber (Label: 'VAT number', Attribute: "VATNumber")
          textbox txtReference (Label: 'Reference', Attribute: "Reference")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hSalespurchase (Content: 'Sales & purchase', RenderMode: H2)
          checkbox cbIsCustomer (Label: 'Is customer', Attribute: "IsCustomer")
          combobox cmbPartnerSalesperson (Label: 'Salesperson', Attribute: Partner_Salesperson, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName")
          combobox cmbPartnerCustomerPaymentTerm (Label: 'Customer payment term', Attribute: Partner_CustomerPaymentTerm, DataSource: database Core."PaymentTerm" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbPartnerPricelist (Label: 'Pricelist', Attribute: Partner_Pricelist, DataSource: database Products."Pricelist" sort by "Name" asc, CaptionAttribute: "Name")
          checkbox cbIsVendor (Label: 'Is vendor', Attribute: "IsVendor")
          combobox cmbPartnerVendorPaymentTerm (Label: 'Vendor payment term', Attribute: Partner_VendorPaymentTerm, DataSource: database Core."PaymentTerm" sort by "Name" asc, CaptionAttribute: "Name")
        }
      }
    }
    dynamictext hContactsaddresses (Content: 'Contacts & addresses', RenderMode: H2)
    datagrid gridContactsaddresses (DataSource: database Partners."Partner" where [Partners.Partner_ParentCompany = '[%CurrentObject%]'], Class: 'density-compact', OnClick: show page Partners.PartnerChild_NewEdit(Partner = $currentObject)) {
      column (Attribute: "AddressType", Caption: 'Address type')
      column (Attribute: "Name", Caption: 'Name')
      column (Attribute: "Email", Caption: 'Email')
      column (Attribute: "Phone", Caption: 'Phone')
      column (Attribute: "City", Caption: 'City')
    }
    linkbutton btnAddChild (Caption: '+ Add', Action: call microflow Partners.ACT_Partner_AddToPartner(Partner = $currentObject))
    textarea taNotes (Label: 'Notes', Attribute: "Notes")
  }
      }
    }
  }
};

grant view on page Partners.Partner_NewEdit to Partners.Editor, Partners.Admin;
grant execute on microflow Partners.ACT_Partner_AddToPartner to Partners.Editor, Partners.Admin;
grant execute on microflow Partners.ACT_Partner_Archive to Partners.Editor, Partners.Admin;
grant execute on microflow Partners.ACT_Partner_Save to Partners.Editor, Partners.Admin;
