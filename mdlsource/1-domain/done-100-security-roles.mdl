mdl 1;
-- 100-security-roles.mdl — GENERATED by pipelines/odoo/mdl_domain.py (build-plan row 6).
-- Module roles per arch_blueprint.MODULE_ROLES and the 9 user roles composed of them.
-- Core.User (scaffold role: home page) is kept and given to every user role.

create module if not exists Core;
create module if not exists Products;
create module if not exists Partners;
create module if not exists Sales;
create module if not exists Purchasing;
create module if not exists Inventory;
create module if not exists Invoicing;

create or modify module role Core.Admin description 'Full configuration of the module';
create or modify module role Core.Config description 'Maintains the module''s configuration data';
create or modify module role Core.Reader description 'Read-only access (lookups from other modules)';
create or modify module role Products.Manager description 'Full access incl. configuration and delete';
create or modify module role Products.Reader description 'Read-only access (lookups from other modules)';
create or modify module role Partners.Editor description 'Create and edit records';
create or modify module role Partners.Admin description 'Full configuration of the module';
create or modify module role Partners.Reader description 'Read-only access (lookups from other modules)';
create or modify module role Sales.User description 'Day-to-day work on own documents';
create or modify module role Sales.Manager description 'Full access incl. configuration and delete';
create or modify module role Sales.Reader description 'Read-only access (lookups from other modules)';
create or modify module role Purchasing.User description 'Day-to-day work on own documents';
create or modify module role Purchasing.Manager description 'Full access incl. configuration and delete';
create or modify module role Purchasing.Reader description 'Read-only access (lookups from other modules)';
create or modify module role Inventory.User description 'Day-to-day work on own documents';
create or modify module role Inventory.Manager description 'Full access incl. configuration and delete';
create or modify module role Inventory.Reader description 'Read-only access (lookups from other modules)';
create or modify module role Invoicing.Billing description 'Invoices, bills and payments';
create or modify module role Invoicing.Manager description 'Full access incl. configuration and delete';
create or modify module role Invoicing.Creator description 'Creates invoices from orders (bridge)';

create or modify user role Administrator (
  ModuleRoles: (System.Administrator, Administration.Administrator, Core.User, WorkflowCommons.Administrator, Core.Admin, Products.Manager, Partners.Admin, Sales.Reader, Purchasing.Reader, Inventory.Manager),
  ManageAllRoles: true,
  CheckSecurity: true
);
create or modify user role SalesUser (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Reader, Products.Reader, Partners.Editor, Sales.User, Inventory.Reader, Invoicing.Creator),
  CheckSecurity: true
);
create or modify user role SalesManager (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Reader, Products.Manager, Partners.Editor, Sales.Manager, Inventory.Reader, Invoicing.Creator),
  CheckSecurity: true
);
create or modify user role Purchaser (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Reader, Products.Reader, Partners.Editor, Purchasing.User, Inventory.Reader, Invoicing.Creator),
  CheckSecurity: true
);
create or modify user role PurchaseManager (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Reader, Products.Manager, Partners.Editor, Purchasing.Manager, Inventory.Reader, Invoicing.Creator),
  CheckSecurity: true
);
create or modify user role InventoryUser (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Reader, Products.Reader, Partners.Reader, Sales.Reader, Purchasing.Reader, Inventory.User),
  CheckSecurity: true
);
create or modify user role InventoryManager (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Reader, Products.Manager, Partners.Reader, Sales.Reader, Purchasing.Reader, Inventory.Manager),
  CheckSecurity: true
);
create or modify user role Billing (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Reader, Products.Reader, Partners.Editor, Sales.Reader, Purchasing.Reader, Invoicing.Billing),
  CheckSecurity: true
);
create or modify user role InvoicingManager (
  ModuleRoles: (System.User, Administration.User, Core.User, WorkflowCommons.User, Core.Config, Products.Reader, Partners.Editor, Sales.Reader, Purchasing.Reader, Invoicing.Manager),
  CheckSecurity: true
);
