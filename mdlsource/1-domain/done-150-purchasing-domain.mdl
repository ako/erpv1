  "Discount": Decimal,
  "LeadTimeDays": Integer default 1,
  "VendorProductCode": String(200),
  "VendorProductName": String(200),
  "ValidFrom": DateTime not localized,
  "ValidTo": DateTime not localized,
  "Sequence": Integer default 1,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
);

/** A request for quotation that becomes a (possibly approved) purchase order. (Odoo purchase.order; F005, F007) */
create or modify persistent entity Purchasing."PurchaseOrder" (
  "Number": String(200),
  "Status": Enumeration(Purchasing.ENUM_PurchaseOrderStatus) default RFQ,
  "Locked": Boolean,
  "OrderDeadline": DateTime,
  "ConfirmationDate": DateTime,
  "ExpectedArrival": DateTime,
  "VendorReference": String(200),
  "Source": String(200),
  "Notes": String(unlimited),
  "ApprovalComment": String(unlimited),
  "AmountUntaxed": Decimal,
  "AmountTax": Decimal,
  "AmountTotal": Decimal,
  "BillingStatus": Enumeration(Core.ENUM_InvoiceStatus) default NothingToInvoice,
  "ReceiptStatus": Enumeration(Purchasing.ENUM_ReceiptStatus),
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Number", "Status");

