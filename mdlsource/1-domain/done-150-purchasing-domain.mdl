/** Values of Odoo purchase.order.state. ''''done'''' (locked) replaced by the Locked boolean, as Odoo 18 itself does for sales orders */
create or modify enumeration Purchasing."ENUM_PurchaseOrderStatus" (
  "RFQ" 'Request for quotation',
  "RFQSent" 'RFQ sent',
  "ToApprove" 'To approve',
  "PurchaseOrder" 'Purchase order',
  "Cancelled" 'Cancelled'
) folder 'Enumerations';

/** Values of Odoo purchase.order.receipt_status. */
create or modify enumeration Purchasing."ENUM_ReceiptStatus" (
  "NotReceived" 'Not received',
  "PartiallyReceived" 'Partially received',
  "FullyReceived" 'Fully received'
) folder 'Enumerations';

/** A vendor''s price and lead time for a product (drives RFQ prices). (Odoo product.supplierinfo; F005) */
create or modify persistent entity Purchasing."VendorPrice" (
  "MinQuantity": Decimal default 0,
