/** Values of Odoo account.move.state. */
create or modify enumeration Invoicing."ENUM_InvoiceStatus" (
  "Draft" 'Draft',
  "Posted" 'Posted',
  "Cancelled" 'Cancelled'
) folder 'Enumerations';

/** Values of Odoo account.move.move_type. ''''entry'''' (journal entries) and receipts dropped: no general ledger in scope */
create or modify enumeration Invoicing."ENUM_InvoiceType" (
  "CustomerInvoice" 'Customer invoice',
  "CustomerCreditNote" 'Customer credit note',
  "VendorBill" 'Vendor bill',
  "VendorCreditNote" 'Vendor credit note'
) folder 'Enumerations';

/** Values of Odoo account.payment.partner_type. */
create or modify enumeration Invoicing."ENUM_PartnerKind" (
  "Customer" 'Customer',
  "Vendor" 'Vendor'
) folder 'Enumerations';

/** Values of Odoo account.payment.payment_type. */
create or modify enumeration Invoicing."ENUM_PaymentDirection" (
  "Inbound" 'Receive money',
  "Outbound" 'Send money'
) folder 'Enumerations';

/** Values of Odoo None. new: replaces account.journal (bank/cash journals) + account.payment.method.line */
create or modify enumeration Invoicing."ENUM_PaymentMethod" (
  "BankTransfer" 'Bank transfer',
  "Cash" 'Cash'
) folder 'Enumerations';

/** Values of Odoo account.payment.state. ''''in_process'''' and ''''rejected'''' are bank-reconciliation states; dropped */
create or modify enumeration Invoicing."ENUM_PaymentState" (
  "Draft" 'Draft',
  "Paid" 'Paid',
  "Cancelled" 'Cancelled'
) folder 'Enumerations';

/** Values of Odoo account.move.payment_state. ''''in_payment'''' (bank reconciliation pending), ''''blocked'''', ''''invoicing_legacy'''' dropped */
create or modify enumeration Invoicing."ENUM_PaymentStatus" (
  "NotPaid" 'Not paid',
  "PartiallyPaid" 'Partially paid',
  "Paid" 'Paid',
  "Reversed" 'Reversed'
) folder 'Enumerations';

/** Customer invoice / credit note or vendor bill / credit note (no journal entries). (Odoo account.move; F008) */
create or modify persistent entity Invoicing."Invoice" (
  "Number": String(200) unique error message 'Another entry with the same number already exists.',
  "InvoiceType": Enumeration(Invoicing.ENUM_InvoiceType),
  "Status": Enumeration(Invoicing.ENUM_InvoiceStatus) default Draft,
  "PaymentStatus": Enumeration(Invoicing.ENUM_PaymentStatus),
  "InvoiceDate": DateTime not localized,
  "DueDate": DateTime not localized,
  "Reference": String(200),
  "PaymentReference": String(200),
  "SourceDocument": String(200),
  "Notes": String(unlimited),
  "AmountUntaxed": Decimal,
  "AmountTax": Decimal,
  "AmountTotal": Decimal,
  "AmountDue": Decimal,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Number", "Status", "InvoiceDate");

/** A product, section or note line of an invoice (no tax/receivable/payable journal items). (Odoo account.move.line; F008) */
create or modify persistent entity Invoicing."InvoiceLine" (
  "Sequence": Integer,
  "LineType": Enumeration(Core.ENUM_LineType),
  "Description": String(200),
  "Quantity": Decimal,
  "UnitPrice": Decimal,
  "DiscountPercent": Decimal default 0,
  "Subtotal": Decimal,
  "Total": Decimal,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
);

/** Money received from a customer or paid to a vendor, allocated to invoices. (Odoo account.payment; F008) */
create or modify persistent entity Invoicing."Payment" (
  "Number": String(200) unique error message 'Another payment with the same number already exists.',
  "Direction": Enumeration(Invoicing.ENUM_PaymentDirection) default Inbound,
  "PartnerKind": Enumeration(Invoicing.ENUM_PartnerKind) default Customer,
  "Amount": Decimal,
  "PaymentDate": DateTime not localized,
  "Memo": String(200),
  "Status": Enumeration(Invoicing.ENUM_PaymentState) default Draft,
  "Method": Enumeration(Invoicing.ENUM_PaymentMethod),
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Number", "Status");

/** Amount of a payment applied to one invoice (makes partial payments explicit). (Odoo None; F008) */
create or modify persistent entity Invoicing."PaymentAllocation" (
  "Amount": Decimal,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
);

/** Wizard data: register a payment for one or more posted invoices. (Odoo account.payment.register; F008) */
create or modify non-persistent entity Invoicing."RegisterPaymentRequest" (
  "Amount": Decimal,
  "PaymentDate": DateTime not localized,
  "Memo": String(200),
  "Method": Enumeration(Invoicing.ENUM_PaymentMethod)
);

/** Wizard data: reverse a posted invoice into a credit note. (Odoo account.move.reversal; F008) */
create or modify non-persistent entity Invoicing."CreditNoteRequest" (
  "Reason": String(200),
  "ReversalDate": DateTime not localized
);

