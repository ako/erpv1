index ("Name");

/** Document numbering per document type (S00001, P00001, WH/IN/00001, INV/2026/00001, ...). (Odoo ir.sequence; F001) */
create or modify persistent entity Core."Sequence" (
  "Code": String(50),
  "Prefix": String(30),
  "Padding": Integer default 5,
  "NextNumber": Integer default 1,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
