  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** When an invoice must be paid: one or more instalments. (Odoo account.payment.term; F001) */
create or modify persistent entity Core."PaymentTerm" (
  "Name": String(200),
  "Note": String(unlimited),
  "Sequence": Integer default 10,
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** One instalment: percent or fixed amount, due N days after a reference date. (Odoo account.payment.term.line; F001) */
create or modify persistent entity Core."PaymentTermLine" (
  "Value": Enumeration(Core.ENUM_PaymentTermValue) default Percent,
  "ValueAmount": Decimal,
  "Days": Integer,
  "DelayType": Enumeration(Core.ENUM_PaymentTermDelay) default DaysAfterInvoiceDate,
