  ChangedBy: AutoChangedBy
);

/** A sales or purchase tax: percentage or fixed amount, price-included or not. (Odoo account.tax; F001) */
create or modify persistent entity Core."Tax" (
  "Name": String(200),
  "Scope": Enumeration(Core.ENUM_TaxScope) default Sales,
