/** Values of Odoo account.payment.term.line.delay_type. two rarer delay types dropped */
create or modify enumeration Core."ENUM_PaymentTermDelay" (
  "DaysAfterInvoiceDate" 'Days after invoice date',
  "DaysAfterEndOfMonth" 'Days after end of month'
) folder 'Enumerations';

/** Values of Odoo account.payment.term.line.value. */
create or modify enumeration Core."ENUM_PaymentTermValue" (
  "Percent" 'Percent',
  "Fixed" 'Fixed amount'
) folder 'Enumerations';

/** Values of Odoo account.tax.amount_type. ''''group'''' and ''''division'''' dropped */
create or modify enumeration Core."ENUM_TaxComputation" (
  "Percentage" 'Percentage of price',
  "Fixed" 'Fixed amount per unit'
) folder 'Enumerations';

/** Values of Odoo account.tax.type_tax_use. ''''none'''' (tax groups children) dropped */
create or modify enumeration Core."ENUM_TaxScope" (
  "Sales" 'Sales',
  "Purchases" 'Purchases'
) folder 'Enumerations';

/** Values of Odoo sale.order.invoice_status. sale ''''upselling'''' dropped; shared by sales and purchase orders (purchase.order.invoice_status has the same 3 values) */
create or modify enumeration Core."ENUM_InvoiceStatus" (
  "NothingToInvoice" 'Nothing to invoice',
  "ToInvoice" 'To invoice',
  "FullyInvoiced" 'Fully invoiced'
) folder 'Enumerations';

/** Values of Odoo sale.order.line.display_type. Odoo uses display_type=False for product lines; made explicit. Shared by sales, purchase and invoice lines */
create or modify enumeration Core."ENUM_LineType" (
  "Product" 'Product line',
  "Section" 'Section',
  "Note" 'Note'
) folder 'Enumerations';

/** The single company operating the app: identity, currency and document defaults. (Odoo res.company; F001) */
create or modify persistent entity Core."Company" (
  "Name": String(200),
  "Email": String(200),
  "Phone": String(200),
  "Street": String(200),
  "Street2": String(200),
  "Zip": String(200),
  "City": String(200),
  "VATNumber": String(200),
  "Website": String(200),
  "QuotationValidityDays": Integer default 30,
  "POApprovalEnabled": Boolean,
  "POApprovalThreshold": Decimal default 5000,
  "PurchaseLeadDays": Decimal default 0,
  "InvoiceTerms": String(unlimited),
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** Countries for addresses. (Odoo res.country; F001) */
create or modify persistent entity Core."Country" (
  "Name": String(200),
  "Code": String(2),
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** Currency of the company and its documents. (Odoo res.currency; F001) */
create or modify persistent entity Core."Currency" (
  "Name": String(3),
  "Symbol": String(200),
  "Rounding": Decimal default 0.01,
  "DecimalPlaces": Integer,
