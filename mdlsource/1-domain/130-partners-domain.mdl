mdl 1;
-- 130-partners-domain.mdl — GENERATED by pipelines/odoo/mdl_domain.py (build-plan Phase 1).
-- Enumerations, entities, associations owned by Partners, then entity access (co-located grants).
-- Create/delete rights follow the approved access table; document state rules live in ACT_/SUB_ microflows.

/** Values of Odoo res.partner.type. */
create or modify enumeration Partners."ENUM_AddressType" (
  "Contact" 'Contact',
  "Invoice" 'Invoice address',
  "Delivery" 'Delivery address',
  "Other" 'Other address'
) folder 'Enumerations';

/** Business data of an app user (Mendix account): display name and linked partner. Team membership lives on Sales.SalesTeam. (Odoo res.users; F001) */
create or modify persistent entity Partners."UserProfile" (
  "DisplayName": String(200),
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
);

/** Any customer, vendor or contact person — companies and their contacts/addresses. (Odoo res.partner; F001) */
create or modify persistent entity Partners."Partner" (
  "Name": String(200),
  "IsCompany": Boolean,
  "AddressType": Enumeration(Partners.ENUM_AddressType),
  "Email": String(200),
  "Phone": String(200),
  "Mobile": String(200),
  "JobPosition": String(200),
  "Street": String(200),
  "Street2": String(200),
  "Zip": String(200),
  "City": String(200),
  "VATNumber": String(200),
  "Website": String(200),
  "Reference": String(200),
  "Notes": String(unlimited),
  "IsCustomer": Boolean,
  "IsVendor": Boolean,
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** Free tags to classify partners. (Odoo res.partner.category; F001) */
create or modify persistent entity Partners."PartnerTag" (
  "Name": String(200),
  "Color": Integer,
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** Bank account of a partner (shown on vendor bills / customer payments). (Odoo res.partner.bank; F001) */
create or modify persistent entity Partners."BankAccount" (
  "AccountNumber": String(200),
  "HolderName": String(200),
  "BankName": String(200),
  "BIC": String(20),
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
);

/** Mendix account (System.User) — replaces res.users login/groups */
create or modify association Partners."UserProfile_Account"
  from Partners."UserProfile" to Administration."Account"
  type Reference;
/** res.users _inherits res.partner -> association, not generalization */
create or modify association Partners."UserProfile_Partner"
  from Partners."UserProfile" to Partners."Partner"
  type Reference;
/** contacts and addresses belong to a company */
create or modify association Partners."Partner_ParentCompany"
  from Partners."Partner" to Partners."Partner"
  type Reference;
/** Odoo res.partner.country_id */
create or modify association Partners."Partner_Country"
  from Partners."Partner" to Core."Country"
  type Reference;
/** Odoo res.partner.category_id */
create or modify association Partners."Partner_Tags"
  from Partners."Partner" to Partners."PartnerTag"
  type ReferenceSet
  owner Both;
/** Odoo res.partner.user_id */
create or modify association Partners."Partner_Salesperson"
  from Partners."Partner" to Administration."Account"
  type Reference;
/** company-dependent in Odoo; single company here */
create or modify association Partners."Partner_CustomerPaymentTerm"
  from Partners."Partner" to Core."PaymentTerm"
  type Reference;
/** Odoo res.partner.property_supplier_payment_term_id */
create or modify association Partners."Partner_VendorPaymentTerm"
  from Partners."Partner" to Core."PaymentTerm"
  type Reference;
/** Odoo res.partner.property_product_pricelist */
create or modify association Partners."Partner_Pricelist"
  from Partners."Partner" to Products."Pricelist"
  type Reference;
/** Odoo res.partner.bank.partner_id */
create or modify association Partners."BankAccount_Partner"
  from Partners."BankAccount" to Partners."Partner"
  type Reference;

