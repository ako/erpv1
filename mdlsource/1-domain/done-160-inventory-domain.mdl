mdl 1;
-- 160-inventory-domain.mdl — GENERATED by pipelines/odoo/mdl_domain.py (build-plan Phase 1).
-- Enumerations, entities, associations owned by Inventory, then entity access (co-located grants).
-- Create/delete rights follow the approved access table; document state rules live in ACT_/SUB_ microflows.

/** Values of Odoo stock.location.usage. ''''production'''' (MRP) and ''''transit'''' (inter-warehouse) dropped */
create or modify enumeration Inventory."ENUM_LocationType" (
  "Vendor" 'Vendor location',
  "View" 'View',
  "Internal" 'Internal location',
  "Customer" 'Customer location',
  "InventoryLoss" 'Inventory loss / adjustment'
) folder 'Enumerations';

/** Values of Odoo stock.picking.type.code. */
create or modify enumeration Inventory."ENUM_OperationKind" (
  "Receipt" 'Receipt',
  "Delivery" 'Delivery',
  "Internal" 'Internal transfer'
) folder 'Enumerations';

/** Values of Odoo stock.picking.state. ''''waiting'''' (waiting another operation) dropped: no chained multi-step routes. Also used for stock moves */
create or modify enumeration Inventory."ENUM_TransferStatus" (
  "Draft" 'Draft',
  "Waiting" 'Waiting',
  "Ready" 'Ready',
  "Done" 'Done',
  "Cancelled" 'Cancelled'
) folder 'Enumerations';

/** The (single) warehouse: its stock location and operation types. (Odoo stock.warehouse; F006) */
create or modify persistent entity Inventory."Warehouse" (
  "Name": String(200),
  "ShortName": String(5),
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** A physical or virtual place stock moves from/to (WH/Stock, Vendors, Customers, Inventory adjustment). (Odoo stock.location; F006) */
create or modify persistent entity Inventory."Location" (
  "Name": String(200),
  "FullName": String(200),
  "LocationType": Enumeration(Inventory.ENUM_LocationType) default Internal,
  "Barcode": String(200),
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** Receipts, Delivery orders, Internal transfers: numbering and default locations. (Odoo stock.picking.type; F006) */
create or modify persistent entity Inventory."OperationType" (
  "Name": String(200),
  "Kind": Enumeration(Inventory.ENUM_OperationKind) default Receipt,
  "SequenceCode": String(200),
  "CreateBackorder": Boolean,
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** A receipt, delivery or internal transfer grouping stock moves. (Odoo stock.picking; F006, F007) */
create or modify persistent entity Inventory."Transfer" (
  "Number": String(200) default '/',
  "Status": Enumeration(Inventory.ENUM_TransferStatus),
  "ScheduledDate": DateTime,
  "DateDone": DateTime,
  "Deadline": DateTime,
  "SourceDocument": String(200),
  "Notes": String(unlimited),
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Number", "Status", "ScheduledDate");

/** Movement of one product quantity between two locations (stock.move.line merged in). (Odoo stock.move; F006, F007) */
create or modify persistent entity Inventory."StockMove" (
  "Description": String(200),
  "Status": Enumeration(Inventory.ENUM_TransferStatus) default Draft,
  "Date": DateTime,
  "DemandQuantity": Decimal default 0,
  "Quantity": Decimal,
  "Picked": Boolean default false,
  "SourceDocument": String(200),
  "IsInventoryAdjustment": Boolean,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Status", "Date");

/** Quantity of a product in an internal location (on hand, reserved, counted). (Odoo stock.quant; F006) */
create or modify persistent entity Inventory."StockLevel" (
  "Quantity": Decimal,
  "ReservedQuantity": Decimal default 0,
  "CountedQuantity": Decimal,
  "CountSet": Boolean default false,
  "ScheduledCountDate": DateTime not localized,
  "IncomingDate": DateTime,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
);

/** Min/max replenishment rule: below minimum, create an RFQ up to maximum. (Odoo stock.warehouse.orderpoint; F006) */
create or modify persistent entity Inventory."ReorderRule" (
  "Name": String(200),
  "MinQuantity": Decimal default 0,
  "MaxQuantity": Decimal default 0,
  "QuantityMultiple": Decimal default 1,
  "Automatic": Boolean,
  "Active": Boolean default true,
  CreatedDate: AutoCreatedDate,
  ChangedDate: AutoChangedDate,
  Owner: AutoOwner,
  ChangedBy: AutoChangedBy
)
index ("Name");

/** Wizard data: validate a transfer with less than the demand — create a backorder or not. (Odoo stock.backorder.confirmation; F006) */
create or modify non-persistent entity Inventory."ValidateTransferRequest" (
  "CreateBackorder": Boolean default true
);

/** Odoo stock.warehouse.lot_stock_id */
create or modify association Inventory."Warehouse_StockLocation"
  from Inventory."Warehouse" to Inventory."Location"
  type Reference;
/** Odoo stock.warehouse.partner_id */
create or modify association Inventory."Warehouse_Address"
  from Inventory."Warehouse" to Partners."Partner"
  type Reference;
/** Odoo stock.location.location_id */
create or modify association Inventory."Location_Parent"
  from Inventory."Location" to Inventory."Location"
  type Reference;
/** Odoo stock.location.warehouse_id */
create or modify association Inventory."Location_Warehouse"
  from Inventory."Location" to Inventory."Warehouse"
  type Reference;
/** Odoo stock.picking.type.warehouse_id */
create or modify association Inventory."OperationType_Warehouse"
  from Inventory."OperationType" to Inventory."Warehouse"
  type Reference;
/** Odoo stock.picking.type.default_location_src_id */
create or modify association Inventory."OperationType_DefaultSource"
  from Inventory."OperationType" to Inventory."Location"
  type Reference;
/** Odoo stock.picking.type.default_location_dest_id */
create or modify association Inventory."OperationType_DefaultDestination"
