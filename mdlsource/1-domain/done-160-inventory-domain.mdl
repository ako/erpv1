  type Reference;
/** Odoo stock.picking.picking_type_id */
create or modify association Inventory."Transfer_OperationType"
  from Inventory."Transfer" to Inventory."OperationType"
  type Reference;
/** Odoo stock.picking.partner_id */
create or modify association Inventory."Transfer_Partner"
  from Inventory."Transfer" to Partners."Partner"
  type Reference;
/** Odoo stock.picking.location_id */
create or modify association Inventory."Transfer_SourceLocation"
  from Inventory."Transfer" to Inventory."Location"
  type Reference;
/** Odoo stock.picking.location_dest_id */
create or modify association Inventory."Transfer_DestinationLocation"
  from Inventory."Transfer" to Inventory."Location"
  type Reference;
/** the transfer this one is the backorder of */
create or modify association Inventory."Transfer_Backorder"
  from Inventory."Transfer" to Inventory."Transfer"
  type Reference;
/** sale_stock */
create or modify association Inventory."Transfer_SalesOrder"
  from Inventory."Transfer" to Sales."SalesOrder"
  type Reference;
/** purchase_stock (computed in Odoo via moves; stored here) */
create or modify association Inventory."Transfer_PurchaseOrder"
  from Inventory."Transfer" to Purchasing."PurchaseOrder"
  type Reference;
/** Odoo stock.picking.user_id */
create or modify association Inventory."Transfer_Responsible"
  from Inventory."Transfer" to Administration."Account"
  type Reference;
/** Odoo stock.move.picking_id */
create or modify association Inventory."StockMove_Transfer"
  from Inventory."StockMove" to Inventory."Transfer"
  type Reference;
/** Odoo stock.move.product_id */
create or modify association Inventory."StockMove_Product"
  from Inventory."StockMove" to Products."Product"
  type Reference;
/** Odoo stock.move.product_uom */
create or modify association Inventory."StockMove_UoM"
  from Inventory."StockMove" to Products."UoM"
  type Reference;
/** Odoo stock.move.location_id */
create or modify association Inventory."StockMove_SourceLocation"
  from Inventory."StockMove" to Inventory."Location"
  type Reference;
/** Odoo stock.move.location_dest_id */
create or modify association Inventory."StockMove_DestinationLocation"
  from Inventory."StockMove" to Inventory."Location"
  type Reference;
/** Odoo stock.move.sale_line_id */
create or modify association Inventory."StockMove_SalesOrderLine"
  from Inventory."StockMove" to Sales."SalesOrderLine"
  type Reference;
/** Odoo stock.move.purchase_line_id */
create or modify association Inventory."StockMove_PurchaseOrderLine"
  from Inventory."StockMove" to Purchasing."PurchaseOrderLine"
  type Reference;
/** Odoo stock.quant.product_id */
create or modify association Inventory."StockLevel_Product"
  from Inventory."StockLevel" to Products."Product"
  type Reference;
/** Odoo stock.quant.location_id */
create or modify association Inventory."StockLevel_Location"
  from Inventory."StockLevel" to Inventory."Location"
  type Reference;
/** Odoo stock.warehouse.orderpoint.product_id */
create or modify association Inventory."ReorderRule_Product"
  from Inventory."ReorderRule" to Products."Product"
  type Reference;
/** Odoo stock.warehouse.orderpoint.location_id */
create or modify association Inventory."ReorderRule_Location"
  from Inventory."ReorderRule" to Inventory."Location"
  type Reference;
/** Odoo stock.warehouse.orderpoint.vendor_id */
create or modify association Inventory."ReorderRule_Vendor"
  from Inventory."ReorderRule" to Partners."Partner"
  type Reference;
/** new: RFQs this rule created; owned by Inventory so Purchasing never depends on Inventory */
create or modify association Inventory."ReorderRule_PurchaseOrders"
  from Inventory."ReorderRule" to Purchasing."PurchaseOrder"
  type ReferenceSet
  owner Both;
/** Odoo stock.backorder.confirmation.pick_ids */
create or modify association Inventory."ValidateTransferRequest_Transfer"
  from Inventory."ValidateTransferRequest" to Inventory."Transfer"
  type Reference;

