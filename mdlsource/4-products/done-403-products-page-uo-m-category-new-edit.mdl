/** Persist a validated UoMCategory. */
create or modify microflow Products.SUB_UoMCategory_Save ($UoMCategory: Products.UoMCategory)
folder 'UnitsOfMeasure/Microflows'
begin
  retrieve $Lines0 from $UoMCategory/Products.UoM_Category;
  commit $Lines0 with events;
  commit $UoMCategory with events refresh;
end;

/** Save button on UoMCategory_NewEdit: validate, persist, close. */
create or modify microflow Products.ACT_UoMCategory_Save ($UoMCategory: Products.UoMCategory)
folder 'UnitsOfMeasure/Microflows'
begin
  $IsValid = call microflow Products.VAL_UoMCategory(UoMCategory = $UoMCategory);
  if $IsValid then
    call microflow Products.SUB_UoMCategory_Save(UoMCategory = $UoMCategory);
    close page;
  end if;
end;

/** A new UoM on the UoMCategory, committed so the line editor shows it at once. */
create or modify microflow Products.SUB_UoM_Add ($UoMCategory: Products.UoMCategory)
returns Products.UoM as $Line
folder 'UnitsOfMeasure/Microflows'
begin
  $Line = create Products."UoM" (Products.UoM_Category = $UoMCategory);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on UoMCategory_NewEdit. */
create or modify microflow Products.ACT_UoM_Add ($UoMCategory: Products.UoMCategory)
folder 'UnitsOfMeasure/Microflows'
begin
  $Line = call microflow Products.SUB_UoM_Add(UoMCategory = $UoMCategory);
end;

/** Unit category — UoMCategory_NewEdit. */
create or modify page Products.UoMCategory_NewEdit folder 'UnitsOfMeasure/Pages'
(
  Params: ( $UoMCategory: Products.UoMCategory ),
  Title: 'Unit category',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $UoMCategory) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Unit category', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Name = empty or trim($currentObject/Name) = '' then 'New' else $currentObject/Name), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Products.ACT_UoMCategory_Save(UoMCategory = $currentObject), ButtonStyle: Primary)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          dynamictext hCategory (Content: 'Category', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
        }
      }
    }
    dynamictext hUnits (Content: 'Units', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 3) { dynamictext hdName (Content: 'Name', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdUoMType (Content: 'Unit type', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdFactor (Content: 'Factor', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdRounding (Content: 'Rounding', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdActive (Content: 'Active', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Products.UoM_Category, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { textbox lntxtName (Label: 'Name', Attribute: "Name") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbUoMType (Label: 'Unit type', Attribute: "UoMType") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtFactor (Label: 'Factor', Attribute: "Factor", DecimalPrecision: 8, GroupDigits: true) }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtRounding (Label: 'Rounding', Attribute: "Rounding", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { checkbox lncbActive (Label: 'Active', Attribute: "Active") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Products.ACT_UoM_Add(UoMCategory = $currentObject))
  }
      }
    }
  }
};

