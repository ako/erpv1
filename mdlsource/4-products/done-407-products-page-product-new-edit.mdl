      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Products.ACT_Product_Save(Product = $currentObject), ButtonStyle: Primary)
        actionbutton btnArchive1 (Caption: 'Archive', Action: call microflow Products.ACT_Product_Archive(Product = $currentObject), ButtonStyle: Default)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hGeneral (Content: 'General', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
          textbox txtInternalReference (Label: 'Internal reference', Attribute: "InternalReference")
          textbox txtBarcode (Label: 'Barcode', Attribute: "Barcode")
          combobox cmbProductType (Label: 'Product type', Attribute: "ProductType")
          checkbox cbTrackInventory (Label: 'Track inventory', Attribute: "TrackInventory")
          combobox cmbProductCategory (Label: 'Category', Attribute: Product_Category, DataSource: database Products."ProductCategory" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbProductTags (Label: 'Tags', Attribute: Product_Tags, DataSource: database Products."ProductTag" sort by "Name" asc, CaptionAttribute: "Name")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hSales (Content: 'Sales', RenderMode: H2)
          checkbox cbCanBeSold (Label: 'Can be sold', Attribute: "CanBeSold")
          textbox txtSalesPrice (Label: 'Sales price', Attribute: "SalesPrice", DecimalPrecision: 2, GroupDigits: true)
          combobox cmbProductCustomerTaxes (Label: 'Customer taxes', Attribute: Product_CustomerTaxes, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbInvoicePolicy (Label: 'Invoice policy', Attribute: "InvoicePolicy")
          textarea taSalesDescription (Label: 'Sales description', Attribute: "SalesDescription")
          textbox txtCustomerLeadDays (Label: 'Customer lead days', Attribute: "CustomerLeadDays")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hPurchase (Content: 'Purchase', RenderMode: H2)
          checkbox cbCanBePurchased (Label: 'Can be purchased', Attribute: "CanBePurchased")
          textbox txtCost (Label: 'Cost', Attribute: "Cost", DecimalPrecision: 2, GroupDigits: true)
          combobox cmbProductVendorTaxes (Label: 'Vendor taxes', Attribute: Product_VendorTaxes, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbBillPolicy (Label: 'Bill policy', Attribute: "BillPolicy")
          combobox cmbProductPurchaseUoM (Label: 'Purchase unit', Attribute: Product_PurchaseUoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name")
          textarea taPurchaseDescription (Label: 'Purchase description', Attribute: "PurchaseDescription")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hInventory (Content: 'Inventory', RenderMode: H2)
          combobox cmbProductUoM (Label: 'Unit', Attribute: Product_UoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtWeight (Label: 'Weight', Attribute: "Weight", DecimalPrecision: 2, GroupDigits: true)
          textbox txtVolume (Label: 'Volume', Attribute: "Volume", DecimalPrecision: 2, GroupDigits: true)
        }
      }
    }
    textarea taInternalNotes (Label: 'Internal notes', Attribute: "InternalNotes")
  }
      }
    }
  }
};

