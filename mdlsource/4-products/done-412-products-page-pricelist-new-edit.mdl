-- Regenerate, do not hand-edit. Reached from: row of Pricelist_Overview.

/** Validate a Pricelist before save: every required field on Pricelist_NewEdit, all flagged on one submit. */
create or modify microflow Products.VAL_Pricelist ($Pricelist: Products.Pricelist)
returns Boolean as $IsValid
folder 'Pricing/Microflows'
begin
  declare $IsValid Boolean = true;
  if $Pricelist/Name = empty or trim($Pricelist/Name) = '' then
    validation feedback $Pricelist/Name message 'Name is required.';
    set $IsValid = false;
  end if;
  if $Pricelist/Products.Pricelist_Currency = empty then
    validation feedback $Pricelist/Products.Pricelist_Currency message 'Currency is required.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated Pricelist. */
create or modify microflow Products.SUB_Pricelist_Save ($Pricelist: Products.Pricelist)
folder 'Pricing/Microflows'
begin
  retrieve $Lines0 from $Pricelist/Products.PriceRule_Pricelist;
  commit $Lines0 with events;
  commit $Pricelist with events refresh;
end;

/** Save button on Pricelist_NewEdit: validate, persist, close. */
create or modify microflow Products.ACT_Pricelist_Save ($Pricelist: Products.Pricelist)
folder 'Pricing/Microflows'
begin
  $IsValid = call microflow Products.VAL_Pricelist(Pricelist = $Pricelist);
  if $IsValid then
    call microflow Products.SUB_Pricelist_Save(Pricelist = $Pricelist);
    close page;
  end if;
end;

/** A new PriceRule on the Pricelist, committed so the line editor shows it at once. */
create or modify microflow Products.SUB_PriceRule_Add ($Pricelist: Products.Pricelist)
returns Products.PriceRule as $Line
folder 'Pricing/Microflows'
begin
  $Line = create Products."PriceRule" (Products.PriceRule_Pricelist = $Pricelist);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on Pricelist_NewEdit. */
create or modify microflow Products.ACT_PriceRule_Add ($Pricelist: Products.Pricelist)
folder 'Pricing/Microflows'
begin
  $Line = call microflow Products.SUB_PriceRule_Add(Pricelist = $Pricelist);
end;

/** Pricelist — Pricelist_NewEdit. */
create or modify page Products.Pricelist_NewEdit folder 'Pricing/Pages'
(
  Params: ( $Pricelist: Products.Pricelist ),
  Title: 'Pricelist',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $Pricelist) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Pricelist', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Name = empty or trim($currentObject/Name) = '' then 'New' else $currentObject/Name), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Products.ACT_Pricelist_Save(Pricelist = $currentObject), ButtonStyle: Primary)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          dynamictext hPricelist (Content: 'Pricelist', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
          combobox cmbPricelistCurrency (Label: 'Currency', Attribute: Pricelist_Currency, DataSource: database Core."Currency" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtSequence (Label: 'Sequence', Attribute: "Sequence")
        }
      }
    }
    dynamictext hPricerules (Content: 'Price rules', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 1) { dynamictext hdAppliesTo (Content: 'Applies to', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdPriceRuleCategory (Content: 'Category', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdPriceRuleProduct (Content: 'Product', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdMinQuantity (Content: 'Min quantity', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdComputation (Content: 'Computation', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdFixedPrice (Content: 'Fixed price', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdDiscountPercent (Content: 'Discount percent', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdValidFrom (Content: 'Valid from', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdValidTo (Content: 'Valid to', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Products.PriceRule_Pricelist, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbAppliesTo (Label: 'Applies to', Attribute: "AppliesTo") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbPriceRuleCategory (Label: 'Category', Attribute: PriceRule_Category, DataSource: database Products."ProductCategory" sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbPriceRuleProduct (Label: 'Product', Attribute: PriceRule_Product, DataSource: database Products."Product" where [Active = true()] sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtMinQuantity (Label: 'Min quantity', Attribute: "MinQuantity", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbComputation (Label: 'Computation', Attribute: "Computation") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtFixedPrice (Label: 'Fixed price', Attribute: "FixedPrice", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtDiscountPercent (Label: 'Discount percent', Attribute: "DiscountPercent", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { datepicker lndpValidFrom (Label: 'Valid from', Attribute: "ValidFrom") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { datepicker lndpValidTo (Label: 'Valid to', Attribute: "ValidTo") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Products.ACT_PriceRule_Add(Pricelist = $currentObject))
  }
      }
    }
  }
};

grant view on page Products.Pricelist_NewEdit to Products.Manager;
grant execute on microflow Products.ACT_PriceRule_Add to Products.Manager;
grant execute on microflow Products.ACT_Pricelist_Save to Products.Manager;
