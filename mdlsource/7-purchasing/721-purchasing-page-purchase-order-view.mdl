/** Purchase order — PurchaseOrder_View. */
create or modify page Purchasing.PurchaseOrder_View folder 'RFQs/Pages'
(
  Params: ( $PurchaseOrder: Purchasing.PurchaseOrder ),
  Title: 'Purchase order',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $PurchaseOrder) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Purchase order', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Number = empty or trim($currentObject/Number) = '' then 'New' else $currentObject/Number), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnCreatebill0 (Caption: 'Create bill', Action: call microflow Invoicing.ACT_PurchaseOrder_CreateBill(PurchaseOrder = $currentObject), ButtonStyle: Primary, Visible: $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.PurchaseOrder and $currentObject/BillingStatus = Core.ENUM_InvoiceStatus.ToInvoice)
      }
    }
    dynamictext txtStatus (Content: '{1}', ContentParams: ({1} = "Status"), Class: 'pill pill-info spacing-outer-bottom-medium')
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hVendor (Content: 'Vendor', RenderMode: H2)
          combobox cmbPurchaseOrderVendor (Label: 'Vendor', Attribute: PurchaseOrder_Vendor, DataSource: database Partners."Partner" where [Active = true()][IsVendor = true()] sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          textbox txtVendorReference (Label: 'Vendor reference', Attribute: "VendorReference", Editable: Never)
          combobox cmbPurchaseOrderCurrency (Label: 'Currency', Attribute: PurchaseOrder_Currency, DataSource: database Core."Currency" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hDates (Content: 'Dates', RenderMode: H2)
          datepicker dpOrderDeadline (Label: 'Order deadline', Attribute: "OrderDeadline", Editable: Never)
          datepicker dpExpectedArrival (Label: 'Expected arrival', Attribute: "ExpectedArrival", Editable: Never)
          datepicker dpConfirmationDate (Label: 'Confirmation date', Attribute: "ConfirmationDate", Editable: Never)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hOtherinfo (Content: 'Other info', RenderMode: H2)
          combobox cmbPurchaseOrderBuyer (Label: 'Buyer', Attribute: PurchaseOrder_Buyer, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName", Editable: Never)
          combobox cmbPurchaseOrderPaymentTerm (Label: 'Payment term', Attribute: PurchaseOrder_PaymentTerm, DataSource: database Core."PaymentTerm" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          textbox txtSource (Label: 'Source', Attribute: "Source", Editable: Never)
          combobox cmbReceiptStatus (Label: 'Receipt status', Attribute: "ReceiptStatus", Editable: Never)
          combobox cmbBillingStatus (Label: 'Billing status', Attribute: "BillingStatus", Editable: Never)
          checkbox cbLocked (Label: 'Locked', Attribute: "Locked", Editable: Never)
        }
      }
    }
    dynamictext hProducts (Content: 'Products', RenderMode: H2)
    datagrid gridProducts (DataSource: database Purchasing."PurchaseOrderLine" where [Purchasing.PurchaseOrderLine_PurchaseOrder = '[%CurrentObject%]'], Class: 'density-compact') {
      column (Attribute: PurchaseOrderLine_Product/Name, Caption: 'Product', WrapText: true)
      column (Attribute: "Quantity", Caption: 'Quantity', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
      column (Attribute: "QuantityReceived", Caption: 'Quantity received', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
      column (Attribute: PurchaseOrderLine_UoM/Name, Caption: 'Unit', WrapText: true)
      column (Attribute: "UnitPrice", Caption: 'Unit price', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
      column (Attribute: "Subtotal", Caption: 'Subtotal', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
    }
    container ctnTotals (Class: 'spacing-outer-bottom-large') {
      textbox txtAmountUntaxed (Label: 'Amount untaxed', Attribute: "AmountUntaxed", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTax (Label: 'Amount tax', Attribute: "AmountTax", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTotal (Label: 'Amount total', Attribute: "AmountTotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
    }
    textarea taNotes (Label: 'Notes', Attribute: "Notes")
  }
      }
    }
  }
};

grant view on page Purchasing.PurchaseOrder_View to Purchasing.Reader;
