mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["PurchaseOrder_Overview"] — wireframe design/wireframes/PurchaseOrder_Overview.html.
-- Regenerate, do not hand-edit. Reached from: menu Purchase › RFQs & orders; home of Purchaser.

/** Requests for quotation & purchase orders — PurchaseOrder_Overview. */
create or modify page Purchasing.PurchaseOrder_Overview folder 'RFQs/Pages'
(
  Title: 'Requests for quotation & purchase orders',
  Layout: Core.App_Default,
  Url: 'purchase-order-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
    container ctnPageHeadTitle (Class: 'page-head-title') {
      dynamictext txtTitle (Content: 'Requests for quotation & purchase orders', RenderMode: H1)
    }
    container ctnPageHeadActions (Class: 'page-head-actions') {
      actionbutton btnNew (Caption: 'New', Action: call microflow Purchasing.ACT_PurchaseOrder_New, ButtonStyle: Primary)
    }
  }
  datagrid gridMain (DataSource: database Purchasing."PurchaseOrder" sort by "Number" asc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Purchasing.PurchaseOrder_NewEdit(PurchaseOrder = $currentObject)) {
    column (Attribute: "Number", Caption: 'Number', WrapText: true) { textfilter fNumber }
    column (Attribute: "OrderDeadline", Caption: 'Order deadline', WrapText: true) { datefilter fOrderDeadline }
    column (Attribute: PurchaseOrder_Vendor/Name, Caption: 'Vendor', WrapText: true)
    column (Attribute: PurchaseOrder_Buyer/FullName, Caption: 'Buyer', WrapText: true)
    column (Attribute: "AmountTotal", Caption: 'Amount total', Alignment: right, DynamicCellClass: 'num-right', WrapText: true) { numberfilter fAmountTotal }
    column (Attribute: "Status", Caption: 'Status', WrapText: true) { dropdownfilter fStatus }
    column (Attribute: "ReceiptStatus", Caption: 'Receipt status', WrapText: true) { dropdownfilter fReceiptStatus }
    column (Attribute: "BillingStatus", Caption: 'Billing status', WrapText: true) { dropdownfilter fBillingStatus }
  }
};

grant view on page Purchasing.PurchaseOrder_Overview to Purchasing.User, Purchasing.Manager, Purchasing.Reader;
grant execute on microflow Purchasing.ACT_PurchaseOrder_New to Purchasing.User, Purchasing.Manager;
revoke execute on microflow Purchasing.ACT_PurchaseOrder_New from Purchasing.Reader;
