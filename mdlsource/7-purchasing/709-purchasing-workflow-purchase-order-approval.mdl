mdl 1;
-- 709-purchasing-workflow-purchase-order-approval.mdl — build-plan row 59 (F005-UC004, BRD workflow WF_PurchaseOrderApproval).
-- Its task page, PurchaseApproval_Task (710), is built first: the page takes $WorkflowUserTask + $WorkflowContext.

/**
 * Manager approval of a purchase order above the company threshold (Odoo state 'to approve' + button_approve).
 * One user task for purchase managers. The task page's buttons do the domain work synchronously (SUB_PurchaseApprovalTask_*)
 * and then set the outcome, so the inbox the manager returns to is already up to date; the outcome branches stay empty
 * (an outcome branch runs asynchronously, after the page has closed — journey J-PURCH-02, 2026-10-15).
 */
create or modify workflow Purchasing.WF_PurchaseOrderApproval
  folder 'Approval/Workflows'
  parameter $WorkflowContext: Purchasing.PurchaseOrder
  display 'Purchase order approval'
  description 'A purchase manager approves or rejects a purchase order above the approval threshold.'
begin
  user task ApproveOrder 'Approve purchase order'
    page Purchasing.PurchaseApproval_Task
    targeting users xpath [System.UserRoles/System.UserRole/Name = 'PurchaseManager']
    outcomes 'Approve' { } 'Reject' { };
end workflow;
