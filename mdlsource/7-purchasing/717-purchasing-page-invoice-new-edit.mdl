mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["Invoice_NewEdit"] — wireframe design/wireframes/Invoice_NewEdit.html.
-- Regenerate, do not hand-edit. Reached from: row of Invoice_Overview; New on Invoice_Overview; Invoices / Bills smart button on SalesOrder_NewEdit / PurchaseOrder_NewEdit; invoice link on Payment_View.

/** A new InvoiceLine on the Invoice, committed so the line editor shows it at once. */
create or modify microflow Invoicing.SUB_InvoiceLine_Add ($Invoice: Invoicing.Invoice)
returns Invoicing.InvoiceLine as $Line
folder 'Invoices/Microflows'
begin
  $Line = create Invoicing."InvoiceLine" (Invoicing.InvoiceLine_Invoice = $Invoice);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on Invoice_NewEdit. */
create or modify microflow Invoicing.ACT_InvoiceLine_Add ($Invoice: Invoicing.Invoice)
folder 'Invoices/Microflows'
begin
  $Line = call microflow Invoicing.SUB_InvoiceLine_Add(Invoice = $Invoice);
end;

/** Invoice — Invoice_NewEdit. */
create or modify page Invoicing.Invoice_NewEdit folder 'Invoices/Pages'
(
  Params: ( $Invoice: Invoicing.Invoice ),
  Title: 'Invoice',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $Invoice) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Invoice', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Number = empty or trim($currentObject/Number) = '' then 'New' else $currentObject/Number), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnConfirm1 (Caption: 'Confirm', Action: call microflow Invoicing.ACT_Invoice_Post(Invoice = $currentObject), ButtonStyle: Primary, Visible: $currentObject/Status = Invoicing.ENUM_InvoiceStatus.Draft)
        actionbutton btnResettodraft3 (Caption: 'Reset to draft', Action: call microflow Invoicing.ACT_Invoice_ResetToDraft(Invoice = $currentObject), ButtonStyle: Primary, Visible: $currentObject/Status = Invoicing.ENUM_InvoiceStatus.Posted)
        actionbutton btnCancel4 (Caption: 'Cancel', Action: call microflow Invoicing.ACT_Invoice_Cancel(Invoice = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Invoicing.ENUM_InvoiceStatus.Draft)
      }
    }
    dynamictext txtStatus (Content: '{1}', ContentParams: ({1} = "Status"), Class: 'pill pill-info spacing-outer-bottom-medium')
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hPartner (Content: 'Partner', RenderMode: H2)
          combobox cmbInvoiceType (Label: 'Invoice type', Attribute: "InvoiceType", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          combobox cmbInvoicePartner (Label: 'Partner', Attribute: Invoice_Partner, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          combobox cmbInvoiceDeliveryAddress (Label: 'Delivery address', Attribute: Invoice_DeliveryAddress, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          textbox txtReference (Label: 'Reference', Attribute: "Reference", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          textbox txtPaymentReference (Label: 'Payment reference', Attribute: "PaymentReference", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          combobox cmbInvoiceBankAccount (Label: 'Bank account', Attribute: Invoice_BankAccount, DataSource: database Partners."BankAccount" sort by "AccountNumber" asc, CaptionAttribute: "AccountNumber", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hDatesterms (Content: 'Dates & terms', RenderMode: H2)
          datepicker dpInvoiceDate (Label: 'Invoice date', Attribute: "InvoiceDate", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          datepicker dpDueDate (Label: 'Due date', Attribute: "DueDate", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          combobox cmbInvoicePaymentTerm (Label: 'Payment term', Attribute: Invoice_PaymentTerm, DataSource: database Core."PaymentTerm" sort by "Name" asc, CaptionAttribute: "Name", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          combobox cmbInvoiceCurrency (Label: 'Currency', Attribute: Invoice_Currency, DataSource: database Core."Currency" sort by "Name" asc, CaptionAttribute: "Name", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hOtherinfo (Content: 'Other info', RenderMode: H2)
          combobox cmbInvoiceSalesperson (Label: 'Salesperson', Attribute: Invoice_Salesperson, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          textbox txtSourceDocument (Label: 'Source document', Attribute: "SourceDocument", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
          combobox cmbInvoiceReversalOf (Label: 'Reversal of', Attribute: Invoice_ReversalOf, DataSource: database Invoicing."Invoice" sort by "Number" asc, CaptionAttribute: "Number", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
        }
      }
    }
    dynamictext hInvoicelines (Content: 'Invoice lines', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 3) { dynamictext hdInvoiceLineProduct (Content: 'Product', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdDescription (Content: 'Description', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdQuantity (Content: 'Quantity', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdInvoiceLineUoM (Content: 'Unit', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdUnitPrice (Content: 'Unit price', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdInvoiceLineTaxes (Content: 'Taxes', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdDiscountPercent (Content: 'Discount percent', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdSubtotal (Content: 'Subtotal', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Invoicing.InvoiceLine_Invoice, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbInvoiceLineProduct (Label: 'Product', Attribute: InvoiceLine_Product, DataSource: database Products."Product" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Invoicing.ACT_InvoiceLine_ChangeProduct(InvoiceLine = $currentObject), Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtDescription (Label: 'Description', Attribute: "Description", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtQuantity (Label: 'Quantity', Attribute: "Quantity", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Invoicing.ACT_InvoiceLine_Recompute(InvoiceLine = $currentObject), Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbInvoiceLineUoM (Label: 'Unit', Attribute: InvoiceLine_UoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtUnitPrice (Label: 'Unit price', Attribute: "UnitPrice", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Invoicing.ACT_InvoiceLine_Recompute(InvoiceLine = $currentObject), Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbInvoiceLineTaxes (Label: 'Taxes', Attribute: InvoiceLine_Taxes, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Invoicing.ACT_InvoiceLine_Recompute(InvoiceLine = $currentObject), Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtDiscountPercent (Label: 'Discount percent', Attribute: "DiscountPercent", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Invoicing.ACT_InvoiceLine_Recompute(InvoiceLine = $currentObject), Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtSubtotal (Label: 'Subtotal', Attribute: "Subtotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: call microflow Invoicing.ACT_InvoiceLine_Delete(InvoiceLine = $currentObject), Visible: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Invoicing.ACT_InvoiceLine_Add(Invoice = $currentObject), Visible: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
    container ctnTotals (Class: 'spacing-outer-bottom-large') {
      textbox txtAmountUntaxed (Label: 'Amount untaxed', Attribute: "AmountUntaxed", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTax (Label: 'Amount tax', Attribute: "AmountTax", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTotal (Label: 'Amount total', Attribute: "AmountTotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountDue (Label: 'Amount due', Attribute: "AmountDue", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
    }
    textarea taNotes (Label: 'Notes', Attribute: "Notes", Editable: $Invoice/Status = Invoicing.ENUM_InvoiceStatus.Draft)
    dynamictext hRelated (Content: 'Related', RenderMode: H2)
    linkbutton lnk0 (Caption: 'Open sales order', Action: call microflow Invoicing.ACT_Invoice_OpenSalesOrder(Invoice = $currentObject), Visible: $currentObject/InvoiceType = Invoicing.ENUM_InvoiceType.CustomerInvoice or $currentObject/InvoiceType = Invoicing.ENUM_InvoiceType.CustomerCreditNote)
    linkbutton lnk1 (Caption: 'Open purchase order', Action: call microflow Invoicing.ACT_Invoice_OpenPurchaseOrder(Invoice = $currentObject), Visible: $currentObject/Invoicing.Invoice_PurchaseOrder != empty)
  }
      }
    }
  }
};

grant view on page Invoicing.Invoice_NewEdit to Invoicing.Billing, Invoicing.Manager, Invoicing.Creator;
grant execute on microflow Invoicing.ACT_InvoiceLine_Add to Invoicing.Billing, Invoicing.Manager, Invoicing.Creator;
grant execute on microflow Invoicing.ACT_InvoiceLine_ChangeProduct to Invoicing.Billing, Invoicing.Manager, Invoicing.Creator;
grant execute on microflow Invoicing.ACT_InvoiceLine_Delete to Invoicing.Billing, Invoicing.Manager, Invoicing.Creator;
grant execute on microflow Invoicing.ACT_InvoiceLine_Recompute to Invoicing.Billing, Invoicing.Manager, Invoicing.Creator;
grant execute on microflow Invoicing.ACT_Invoice_Cancel to Invoicing.Billing, Invoicing.Manager;
grant execute on microflow Invoicing.ACT_Invoice_OpenPurchaseOrder to Invoicing.Billing, Invoicing.Manager;
grant execute on microflow Invoicing.ACT_Invoice_OpenSalesOrder to Invoicing.Billing, Invoicing.Manager;
grant execute on microflow Invoicing.ACT_Invoice_Post to Invoicing.Billing, Invoicing.Manager;
grant execute on microflow Invoicing.ACT_Invoice_ResetToDraft to Invoicing.Billing, Invoicing.Manager;
