mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["PurchaseOrder_NewEdit"] — wireframe design/wireframes/PurchaseOrder_NewEdit.html.
-- Regenerate, do not hand-edit. Reached from: row of PurchaseOrder_Overview; New on PurchaseOrder_Overview; Source order link on Transfer_NewEdit; order link on Invoice_NewEdit; Open order on PurchaseApproval_Task.

/** A new PurchaseOrderLine on the PurchaseOrder, committed so the line editor shows it at once. */
create or modify microflow Purchasing.SUB_PurchaseOrderLine_Add ($PurchaseOrder: Purchasing.PurchaseOrder)
returns Purchasing.PurchaseOrderLine as $Line
folder 'RFQs/Microflows'
begin
  $Line = create Purchasing."PurchaseOrderLine" (Purchasing.PurchaseOrderLine_PurchaseOrder = $PurchaseOrder);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on PurchaseOrder_NewEdit. */
create or modify microflow Purchasing.ACT_PurchaseOrderLine_Add ($PurchaseOrder: Purchasing.PurchaseOrder)
folder 'RFQs/Microflows'
begin
  $Line = call microflow Purchasing.SUB_PurchaseOrderLine_Add(PurchaseOrder = $PurchaseOrder);
end;

/** Purchase order — PurchaseOrder_NewEdit. */
create or modify page Purchasing.PurchaseOrder_NewEdit folder 'RFQs/Pages'
(
  Params: ( $PurchaseOrder: Purchasing.PurchaseOrder ),
  Title: 'Purchase order',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $PurchaseOrder) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Purchase order', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Number = empty or trim($currentObject/Number) = '' then 'New' else $currentObject/Number), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSendmarkassent0 (Caption: 'Send (mark as sent)', Action: call microflow Purchasing.ACT_PurchaseOrder_MarkSent(PurchaseOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.RFQ)
        actionbutton btnConfirmorder1 (Caption: 'Confirm order', Action: call microflow Purchasing.ACT_PurchaseOrder_Confirm(PurchaseOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.RFQ or $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.RFQSent)
        actionbutton btnCancelorder3 (Caption: 'Cancel order', Action: call microflow Purchasing.ACT_PurchaseOrder_Cancel(PurchaseOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.RFQ or $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.RFQSent or $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.ToApprove or $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.PurchaseOrder)
        actionbutton btnSettoRFQ4 (Caption: 'Set to RFQ', Action: call microflow Purchasing.ACT_PurchaseOrder_SetToDraft(PurchaseOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.Cancelled)
        actionbutton btnLock5 (Caption: 'Lock', Action: call microflow Purchasing.ACT_PurchaseOrder_ToggleLock(PurchaseOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.PurchaseOrder)
        actionbutton btnSave6 (Caption: 'Save', Action: call microflow Purchasing.ACT_PurchaseOrder_Save(PurchaseOrder = $currentObject), ButtonStyle: Primary)
      }
    }
    dynamictext txtStatus (Content: '{1}', ContentParams: ({1} = "Status"), Class: 'pill pill-info spacing-outer-bottom-medium')
    linkbutton lnkSmartReceipt (Caption: 'Receipt', Action: call microflow Inventory.ACT_PurchaseOrder_OpenReceipt(PurchaseOrder = $currentObject), Visible: $currentObject/Status = Purchasing.ENUM_PurchaseOrderStatus.PurchaseOrder)
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hVendor (Content: 'Vendor', RenderMode: H2)
          combobox cmbPurchaseOrderVendor (Label: 'Vendor', Attribute: PurchaseOrder_Vendor, DataSource: database Partners."Partner" where [Active = true()][IsVendor = true()] sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Purchasing.ACT_PurchaseOrder_ChangeVendor(PurchaseOrder = $currentObject))
          textbox txtVendorReference (Label: 'Vendor reference', Attribute: "VendorReference")
          combobox cmbPurchaseOrderCurrency (Label: 'Currency', Attribute: PurchaseOrder_Currency, DataSource: database Core."Currency" sort by "Name" asc, CaptionAttribute: "Name")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hDates (Content: 'Dates', RenderMode: H2)
          datepicker dpOrderDeadline (Label: 'Order deadline', Attribute: "OrderDeadline")
          datepicker dpExpectedArrival (Label: 'Expected arrival', Attribute: "ExpectedArrival")
          datepicker dpConfirmationDate (Label: 'Confirmation date', Attribute: "ConfirmationDate", Editable: Never)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hOtherinfo (Content: 'Other info', RenderMode: H2)
          combobox cmbPurchaseOrderBuyer (Label: 'Buyer', Attribute: PurchaseOrder_Buyer, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName")
          combobox cmbPurchaseOrderPaymentTerm (Label: 'Payment term', Attribute: PurchaseOrder_PaymentTerm, DataSource: database Core."PaymentTerm" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtSource (Label: 'Source', Attribute: "Source")
          combobox cmbReceiptStatus (Label: 'Receipt status', Attribute: "ReceiptStatus", Editable: Never)
          combobox cmbBillingStatus (Label: 'Billing status', Attribute: "BillingStatus", Editable: Never)
          checkbox cbLocked (Label: 'Locked', Attribute: "Locked", Editable: Never)
        }
      }
    }
    dynamictext hProducts (Content: 'Products', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 3) { dynamictext hdPurchaseOrderLineProduct (Content: 'Product', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdQuantity (Content: 'Quantity', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdQuantityReceived (Content: 'Quantity received', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdPurchaseOrderLineUoM (Content: 'Unit', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdUnitPrice (Content: 'Unit price', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdPurchaseOrderLineTaxes (Content: 'Taxes', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdSubtotal (Content: 'Subtotal', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Purchasing.PurchaseOrderLine_PurchaseOrder, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbPurchaseOrderLineProduct (Label: 'Product', Attribute: PurchaseOrderLine_Product, DataSource: database Products."Product" where [Active = true()][CanBePurchased = true()] sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Purchasing.ACT_PurchaseOrderLine_ChangeProduct(PurchaseOrderLine = $currentObject)) }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtQuantity (Label: 'Quantity', Attribute: "Quantity", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Purchasing.ACT_PurchaseOrderLine_Recompute(PurchaseOrderLine = $currentObject)) }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtQuantityReceived (Label: 'Quantity received', Attribute: "QuantityReceived", DecimalPrecision: 2, GroupDigits: true, Editable: Never) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbPurchaseOrderLineUoM (Label: 'Unit', Attribute: PurchaseOrderLine_UoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtUnitPrice (Label: 'Unit price', Attribute: "UnitPrice", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Purchasing.ACT_PurchaseOrderLine_Recompute(PurchaseOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbPurchaseOrderLineTaxes (Label: 'Taxes', Attribute: PurchaseOrderLine_Taxes, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Purchasing.ACT_PurchaseOrderLine_Recompute(PurchaseOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtSubtotal (Label: 'Subtotal', Attribute: "Subtotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: call microflow Purchasing.ACT_PurchaseOrderLine_Delete(PurchaseOrderLine = $currentObject)) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Purchasing.ACT_PurchaseOrderLine_Add(PurchaseOrder = $currentObject))
    container ctnTotals (Class: 'spacing-outer-bottom-large') {
      textbox txtAmountUntaxed (Label: 'Amount untaxed', Attribute: "AmountUntaxed", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTax (Label: 'Amount tax', Attribute: "AmountTax", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTotal (Label: 'Amount total', Attribute: "AmountTotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
    }
    textarea taNotes (Label: 'Notes', Attribute: "Notes")
  }
      }
    }
  }
};

grant view on page Purchasing.PurchaseOrder_NewEdit to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrderLine_Add to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrderLine_ChangeProduct to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrderLine_Delete to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrderLine_Recompute to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrder_Cancel to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrder_ChangeVendor to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrder_Confirm to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrder_MarkSent to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrder_Save to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrder_SetToDraft to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_PurchaseOrder_ToggleLock to Purchasing.User, Purchasing.Manager;
