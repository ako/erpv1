mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["VendorPrice_Overview"] — wireframe design/wireframes/VendorPrice_Overview.html.
-- Regenerate, do not hand-edit. Reached from: menu Purchase › Vendor prices; Vendor prices link on Product_NewEdit.

/** Checks on one VendorPrice row of VendorPrice_Overview (the row saves on change). */
create or modify microflow Purchasing.VAL_VendorPrice_Row ($VendorPrice: Purchasing.VendorPrice)
returns Boolean as $IsValid
folder 'VendorPrices/Microflows'
begin
  declare $IsValid Boolean = true;
  if $VendorPrice/Price != empty and $VendorPrice/Price < 0 then
    validation feedback $VendorPrice/Price message 'The price cannot be negative.';
    set $IsValid = false;
  end if;
  if $VendorPrice/MinQuantity != empty and $VendorPrice/MinQuantity < 0 then
    validation feedback $VendorPrice/MinQuantity message 'The minimum quantity cannot be negative.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist one checked VendorPrice row. */
create or modify microflow Purchasing.SUB_VendorPrice_SaveRow ($VendorPrice: Purchasing.VendorPrice)
folder 'VendorPrices/Microflows'
begin
  commit $VendorPrice with events refresh;
end;

/** On change of a VendorPrice row on VendorPrice_Overview: save it when its checks pass, else flag the field and keep it unsaved. */
create or modify microflow Purchasing.ACT_VendorPrice_SaveRow ($VendorPrice: Purchasing.VendorPrice)
folder 'VendorPrices/Microflows'
begin
  $IsValid = call microflow Purchasing.VAL_VendorPrice_Row(VendorPrice = $VendorPrice);
  if $IsValid then
    call microflow Purchasing.SUB_VendorPrice_SaveRow(VendorPrice = $VendorPrice);
  end if;
end;

/** A new VendorPrice row, committed so the list shows it at once. */
create or modify microflow Purchasing.SUB_VendorPrice_Add ()
returns Purchasing.VendorPrice as $Row
folder 'VendorPrices/Microflows'
begin
  $Row = create Purchasing."VendorPrice" ();
  commit $Row refresh;
  return $Row;
end;

/** "+ Add a line" on VendorPrice_Overview. */
create or modify microflow Purchasing.ACT_VendorPrice_Add ()
folder 'VendorPrices/Microflows'
begin
  $Row = call microflow Purchasing.SUB_VendorPrice_Add();
end;

/** Vendor prices — VendorPrice_Overview. */
create or modify page Purchasing.VendorPrice_Overview folder 'VendorPrices/Pages'
(
  Title: 'Vendor prices',
  Layout: Core.App_Default,
  Url: 'vendor-price-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
    container ctnPageHeadTitle (Class: 'page-head-title') {
      dynamictext txtTitle (Content: 'Vendor prices', RenderMode: H1)
    }
  }
  layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
    row {
      column (DesktopWidth: 2) { dynamictext hdVendorPriceVendor (Content: 'Vendor', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdVendorPriceProduct (Content: 'Product', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdVendorProductCode (Content: 'Vendor product code', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdMinQuantity (Content: 'Min quantity', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdPrice (Content: 'Price', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdDiscount (Content: 'Discount', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdLeadTimeDays (Content: 'Lead time days', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdValidFrom (Content: 'Valid from', RenderMode: Text) }
      column (DesktopWidth: 1) { dynamictext hdValidTo (Content: 'Valid to', RenderMode: Text) }
    }
  }
  listview lvLines (DataSource: database Purchasing."VendorPrice" sort by VendorPrice_Vendor/Name asc, Editable: true, Class: 'lines-list') {
    layoutgrid gridLine {
      row {
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbVendorPriceVendor (Label: 'Vendor', Attribute: VendorPrice_Vendor, DataSource: database Partners."Partner" where [Active = true()][IsVendor = true()] sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject), Editable: $currentObject/Purchasing.VendorPrice_Vendor = empty) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbVendorPriceProduct (Label: 'Product', Attribute: VendorPrice_Product, DataSource: database Products."Product" where [Active = true()][CanBePurchased = true()] sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject), Editable: $currentObject/Purchasing.VendorPrice_Product = empty) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtVendorProductCode (Label: 'Vendor product code', Attribute: "VendorProductCode", OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtMinQuantity (Label: 'Min quantity', Attribute: "MinQuantity", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtPrice (Label: 'Price', Attribute: "Price", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtDiscount (Label: 'Discount', Attribute: "Discount", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtLeadTimeDays (Label: 'Lead time days', Attribute: "LeadTimeDays", OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { datepicker lndpValidFrom (Label: 'Valid from', Attribute: "ValidFrom", OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { datepicker lndpValidTo (Label: 'Valid to', Attribute: "ValidTo", OnChange: call microflow Purchasing.ACT_VendorPrice_SaveRow(VendorPrice = $currentObject)) }
        column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
      }
    }
  }
  linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Purchasing.ACT_VendorPrice_Add)
};

grant view on page Purchasing.VendorPrice_Overview to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_VendorPrice_Add to Purchasing.User, Purchasing.Manager;
grant execute on microflow Purchasing.ACT_VendorPrice_SaveRow to Purchasing.User, Purchasing.Manager;
