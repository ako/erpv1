mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["Company_Edit"] — wireframe design/wireframes/Company_Edit.html.
-- Regenerate, do not hand-edit. Reached from: menu Configuration › Company; home of Administrator.

/** Validate a Company before save: every required field on Company_Edit, all flagged on one submit. */
create or modify microflow Core.VAL_Company ($Company: Core.Company)
returns Boolean as $IsValid
folder 'Company/Microflows'
begin
  declare $IsValid Boolean = true;
  if $Company/Name = empty or trim($Company/Name) = '' then
    validation feedback $Company/Name message 'Name is required.';
    set $IsValid = false;
  end if;
  if $Company/Core.Company_Currency = empty then
    validation feedback $Company/Core.Company_Currency message 'Currency is required.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated Company. */
create or modify microflow Core.SUB_Company_Save ($Company: Core.Company)
folder 'Company/Microflows'
begin
  commit $Company with events refresh;
end;

/** Save button on Company_Edit: validate, persist, close. */
create or modify microflow Core.ACT_Company_Save ($Company: Core.Company)
folder 'Company/Microflows'
begin
  $IsValid = call microflow Core.VAL_Company(Company = $Company);
  if $IsValid then
    call microflow Core.SUB_Company_Save(Company = $Company);
    close page;
  end if;
end;

/** Data source of Company_Edit: DS_Company_Get (the one company). */
create or modify microflow Core.DS_Company_Get ()
returns Core.Company as $Company
folder 'Company/Microflows'
begin
  retrieve $Company from Core.Company first;
  return $Company;
end;

/** Company — Company_Edit. */
create or modify page Core.Company_Edit folder 'Company/Pages'
(
  Title: 'Company',
  Layout: Core.App_Default,
  Url: 'company-edit'
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: microflow Core.DS_Company_Get) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Company', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = "Name"), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Core.ACT_Company_Save(Company = $currentObject), ButtonStyle: Primary)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hIdentity (Content: 'Identity', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
          textbox txtVATNumber (Label: 'VAT number', Attribute: "VATNumber")
          combobox cmbCompanyCurrency (Label: 'Currency', Attribute: Company_Currency, DataSource: database Core."Currency" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtWebsite (Label: 'Website', Attribute: "Website")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hAddress (Content: 'Address', RenderMode: H2)
          textbox txtStreet (Label: 'Street', Attribute: "Street")
          textbox txtStreet2 (Label: 'Street2', Attribute: "Street2")
          textbox txtZip (Label: 'Zip', Attribute: "Zip")
          textbox txtCity (Label: 'City', Attribute: "City")
          combobox cmbCompanyCountry (Label: 'Country', Attribute: Company_Country, DataSource: database Core."Country" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtEmail (Label: 'Email', Attribute: "Email")
          textbox txtPhone (Label: 'Phone', Attribute: "Phone")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hSales (Content: 'Sales', RenderMode: H2)
          textbox txtQuotationValidityDays (Label: 'Quotation validity days', Attribute: "QuotationValidityDays")
          combobox cmbCompanyDefaultSalesTax (Label: 'Default sales tax', Attribute: Company_DefaultSalesTax, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hPurchase (Content: 'Purchase', RenderMode: H2)
          checkbox cbPOApprovalEnabled (Label: 'PO approval enabled', Attribute: "POApprovalEnabled")
          textbox txtPOApprovalThreshold (Label: 'PO approval threshold', Attribute: "POApprovalThreshold", DecimalPrecision: 2, GroupDigits: true)
          textbox txtPurchaseLeadDays (Label: 'Purchase lead days', Attribute: "PurchaseLeadDays", DecimalPrecision: 2, GroupDigits: true)
          combobox cmbCompanyDefaultPurchaseTax (Label: 'Default purchase tax', Attribute: Company_DefaultPurchaseTax, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hInvoicing (Content: 'Invoicing', RenderMode: H2)
          textarea taInvoiceTerms (Label: 'Invoice terms', Attribute: "InvoiceTerms")
        }
      }
    }
    linkbutton lnk0 (Caption: 'Users', Action: show page Administration.Account_Overview)
  }
      }
    }
  }
};

grant view on page Core.Company_Edit to Core.Admin;
grant execute on microflow Core.ACT_Company_Save to Core.Admin;
grant execute on microflow Core.DS_Company_Get to Core.Admin;
