/** Odoo's checks on a PaymentTerm and its lines (BRD odooConstraints / odooChecks, disposition val). */
create or modify microflow Core.VAL_PaymentTerm_Rules ($PaymentTerm: Core.PaymentTerm)
returns Boolean as $IsValid
folder 'PaymentTerms/Microflows'
begin
  declare $IsValid Boolean = true;
  retrieve $TermLines from $PaymentTerm/Core.PaymentTermLine_PaymentTerm;
  $BadPercent = find $TermLines where $currentObject/Value = Core.ENUM_PaymentTermValue.Percent and ($currentObject/ValueAmount < 0 or $currentObject/ValueAmount > 100);
  if $BadPercent != empty then
    validation feedback $BadPercent/ValueAmount message 'Percentages on the payment term lines must be between 0 and 100.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Validate a PaymentTerm before save: every required field on PaymentTerm_NewEdit, all flagged on one submit. */
create or modify microflow Core.VAL_PaymentTerm ($PaymentTerm: Core.PaymentTerm)
returns Boolean as $IsValid
folder 'PaymentTerms/Microflows'
begin
  declare $IsValid Boolean = true;
  if $PaymentTerm/Name = empty or trim($PaymentTerm/Name) = '' then
    validation feedback $PaymentTerm/Name message 'Name is required.';
    set $IsValid = false;
  end if;
  $RulesValid = call microflow Core.VAL_PaymentTerm_Rules(PaymentTerm = $PaymentTerm);
  if not($RulesValid) then
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated PaymentTerm. */
create or modify microflow Core.SUB_PaymentTerm_Save ($PaymentTerm: Core.PaymentTerm)
folder 'PaymentTerms/Microflows'
begin
  retrieve $Lines0 from $PaymentTerm/Core.PaymentTermLine_PaymentTerm;
  commit $Lines0 with events;
  commit $PaymentTerm with events refresh;
end;

/** Save button on PaymentTerm_NewEdit: validate, persist, close. */
create or modify microflow Core.ACT_PaymentTerm_Save ($PaymentTerm: Core.PaymentTerm)
folder 'PaymentTerms/Microflows'
begin
  $IsValid = call microflow Core.VAL_PaymentTerm(PaymentTerm = $PaymentTerm);
  if $IsValid then
    call microflow Core.SUB_PaymentTerm_Save(PaymentTerm = $PaymentTerm);
    close page;
  end if;
end;

/** A new PaymentTermLine on the PaymentTerm, committed so the line editor shows it at once. */
create or modify microflow Core.SUB_PaymentTermLine_Add ($PaymentTerm: Core.PaymentTerm)
returns Core.PaymentTermLine as $Line
folder 'PaymentTerms/Microflows'
begin
  $Line = create Core."PaymentTermLine" (Core.PaymentTermLine_PaymentTerm = $PaymentTerm);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on PaymentTerm_NewEdit. */
create or modify microflow Core.ACT_PaymentTermLine_Add ($PaymentTerm: Core.PaymentTerm)
folder 'PaymentTerms/Microflows'
begin
  $Line = call microflow Core.SUB_PaymentTermLine_Add(PaymentTerm = $PaymentTerm);
end;

/** Payment term — PaymentTerm_NewEdit. */
create or modify page Core.PaymentTerm_NewEdit folder 'PaymentTerms/Pages'
(
  Params: ( $PaymentTerm: Core.PaymentTerm ),
  Title: 'Payment term',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $PaymentTerm) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Payment term', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Name = empty or trim($currentObject/Name) = '' then 'New' else $currentObject/Name), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Core.ACT_PaymentTerm_Save(PaymentTerm = $currentObject), ButtonStyle: Primary)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          dynamictext hTerm (Content: 'Term', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
          textarea taNote (Label: 'Note', Attribute: "Note")
        }
      }
    }
    dynamictext hInstalments (Content: 'Instalments', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 3) { dynamictext hdValue (Content: 'Value', RenderMode: Text) }
        column (DesktopWidth: 3) { dynamictext hdValueAmount (Content: 'Value amount', RenderMode: Text) }
        column (DesktopWidth: 3) { dynamictext hdDays (Content: 'Days', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdDelayType (Content: 'Delay type', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Core.PaymentTermLine_PaymentTerm, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbValue (Label: 'Value', Attribute: "Value") }
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { textbox lntxtValueAmount (Label: 'Value amount', Attribute: "ValueAmount", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { textbox lntxtDays (Label: 'Days', Attribute: "Days") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbDelayType (Label: 'Delay type', Attribute: "DelayType") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Core.ACT_PaymentTermLine_Add(PaymentTerm = $currentObject))
  }
      }
    }
  }
};

grant view on page Core.PaymentTerm_NewEdit to Core.Admin, Core.Config;
grant execute on microflow Core.ACT_PaymentTermLine_Add to Core.Admin, Core.Config;
grant execute on microflow Core.ACT_PaymentTerm_Save to Core.Admin, Core.Config;
