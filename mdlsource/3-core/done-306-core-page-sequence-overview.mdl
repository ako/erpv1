mdl 1;
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["Sequence_Overview"] — wireframe design/wireframes/Sequence_Overview.html.
-- Regenerate, do not hand-edit. Reached from: menu Configuration › Numbering.

/** Checks on one Sequence row of Sequence_Overview (the row saves on change). */
create or modify microflow Core.VAL_Sequence_Row ($Sequence: Core.Sequence)
returns Boolean as $IsValid
folder 'Numbering/Microflows'
begin
  declare $IsValid Boolean = true;
  if $Sequence/Code = empty or trim($Sequence/Code) = '' then
    validation feedback $Sequence/Code message 'Code is required.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist one checked Sequence row. */
create or modify microflow Core.SUB_Sequence_SaveRow ($Sequence: Core.Sequence)
folder 'Numbering/Microflows'
begin
  commit $Sequence with events refresh;
end;

/** On change of a Sequence row on Sequence_Overview: save it when its checks pass, else flag the field and keep it unsaved. */
create or modify microflow Core.ACT_Sequence_SaveRow ($Sequence: Core.Sequence)
folder 'Numbering/Microflows'
begin
  $IsValid = call microflow Core.VAL_Sequence_Row(Sequence = $Sequence);
  if $IsValid then
    call microflow Core.SUB_Sequence_SaveRow(Sequence = $Sequence);
  end if;
end;

/** Document numbering — Sequence_Overview. */
create or modify page Core.Sequence_Overview folder 'Numbering/Pages'
(
  Title: 'Document numbering',
  Layout: Core.App_Default,
  Url: 'sequence-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
    container ctnPageHeadTitle (Class: 'page-head-title') {
      dynamictext txtTitle (Content: 'Document numbering', RenderMode: H1)
    }
  }
  layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
    row {
      column (DesktopWidth: 4) { dynamictext hdCode (Content: 'Code', RenderMode: Text) }
      column (DesktopWidth: 4) { dynamictext hdPrefix (Content: 'Prefix', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdPadding (Content: 'Padding', RenderMode: Text) }
      column (DesktopWidth: 2) { dynamictext hdNextNumber (Content: 'Next number', RenderMode: Text) }
    }
  }
  listview lvLines (DataSource: database Core."Sequence" sort by "Code" asc, Editable: true, Class: 'lines-list') {
    layoutgrid gridLine {
      row {
        column (DesktopWidth: 4, TabletWidth: 4, PhoneWidth: 12) { textbox lntxtCode (Label: 'Code', Attribute: "Code", Editable: Never) }
        column (DesktopWidth: 4, TabletWidth: 4, PhoneWidth: 12) { textbox lntxtPrefix (Label: 'Prefix', Attribute: "Prefix", OnChange: call microflow Core.ACT_Sequence_SaveRow(Sequence = $currentObject)) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtPadding (Label: 'Padding', Attribute: "Padding", OnChange: call microflow Core.ACT_Sequence_SaveRow(Sequence = $currentObject)) }
        column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtNextNumber (Label: 'Next number', Attribute: "NextNumber", OnChange: call microflow Core.ACT_Sequence_SaveRow(Sequence = $currentObject)) }
      }
    }
  }
};

grant view on page Core.Sequence_Overview to Core.Admin;
grant execute on microflow Core.ACT_Sequence_SaveRow to Core.Admin;
