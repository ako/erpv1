/** Validate a Tax before save: every required field on Tax_NewEdit, all flagged on one submit. */
create or modify microflow Core.VAL_Tax ($Tax: Core.Tax)
returns Boolean as $IsValid
folder 'Company/Microflows'
begin
  declare $IsValid Boolean = true;
  if $Tax/Name = empty or trim($Tax/Name) = '' then
    validation feedback $Tax/Name message 'Name is required.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated Tax. */
create or modify microflow Core.SUB_Tax_Save ($Tax: Core.Tax)
folder 'Company/Microflows'
begin
  commit $Tax with events refresh;
end;

/** Save button on Tax_NewEdit: validate, persist, close. */
create or modify microflow Core.ACT_Tax_Save ($Tax: Core.Tax)
folder 'Company/Microflows'
begin
  $IsValid = call microflow Core.VAL_Tax(Tax = $Tax);
  if $IsValid then
    call microflow Core.SUB_Tax_Save(Tax = $Tax);
    close page;
  end if;
end;

/** Tax — Tax_NewEdit. */
create or modify page Core.Tax_NewEdit folder 'Company/Pages'
(
  Params: ( $Tax: Core.Tax ),
  Title: 'Tax',
  Layout: Atlas_Core.PopupLayout
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $Tax) {
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          textbox txtName (Label: 'Name', Attribute: "Name")
          combobox cmbScope (Label: 'Scope', Attribute: "Scope")
          combobox cmbComputation (Label: 'Computation', Attribute: "Computation")
          textbox txtAmount (Label: 'Amount', Attribute: "Amount", DecimalPrecision: 2, GroupDigits: true)
          checkbox cbIncludedInPrice (Label: 'Included in price', Attribute: "IncludedInPrice")
          textbox txtLabelOnInvoice (Label: 'Label on invoice', Attribute: "LabelOnInvoice")
          textbox txtSequence (Label: 'Sequence', Attribute: "Sequence")
        }
      }
    }
    footer {
      actionbutton btnSave0 (Caption: 'Save', Action: call microflow Core.ACT_Tax_Save(Tax = $currentObject), ButtonStyle: Primary)
      actionbutton btnCancel (Caption: 'Cancel', Action: cancel changes close page)
    }
  }
      }
    }
  }
};

grant view on page Core.Tax_NewEdit to Core.Admin, Core.Config;
grant execute on microflow Core.ACT_Tax_Save to Core.Admin, Core.Config;
