          combobox cmbProductCustomerTaxes (Label: 'Customer taxes', Attribute: Product_CustomerTaxes, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbInvoicePolicy (Label: 'Invoice policy', Attribute: "InvoicePolicy")
          textarea taSalesDescription (Label: 'Sales description', Attribute: "SalesDescription")
