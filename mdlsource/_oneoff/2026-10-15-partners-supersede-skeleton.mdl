mdl 1;
-- One-off: Partners phase 5 supersedes the walking skeleton's contact flows (reshaped: MDL-V1-REBUILD) — drop them and
-- replay the owning phase-5 scripts in this same script (a drop alone fails the gate: pages still call them).
drop microflow Partners.ACT_Partner_Save;
drop microflow Partners.SUB_Partner_Save;
drop microflow Partners.VAL_Partner;
drop microflow Partners.ACT_Partner_New;
drop microflow Partners.SUB_Partner_Create;
-- ── replay: 501-partners-mf-partner
-- 501-partners-mf-partner.mdl — build-plan row 34 (F001). Owns Partners.VAL_Partner.

/**
 * Validate a partner before save (Odoo res.partner constraints), every invalid field on one submit:
 * a name for a contact (addresses may go unnamed); a well-formed email; a partner cannot be its own parent,
 * directly or through its parent chain.
 *
 * @param $Partner the partner being saved
 * @returns true when valid
 */
create or modify microflow Partners.VAL_Partner ($Partner: Partners.Partner)
returns Boolean as $IsValid
folder 'Contacts/Microflows'
begin
  declare $IsValid Boolean = true;
  if $Partner/AddressType = Partners.ENUM_AddressType.Contact and ($Partner/Name = empty or trim($Partner/Name) = '') then
    validation feedback $Partner/Name message 'Name is required.';
    set $IsValid = false;
  end if;
  if $Partner/Email != empty and trim($Partner/Email) != '' and not(isMatch(trim($Partner/Email), '^[^@\s]+@[^@\s]+\.[^@\s]+$')) then
    validation feedback $Partner/Email message 'Enter a valid email address.';
    set $IsValid = false;
  end if;
  retrieve $Parent from $Partner/Partners.Partner_ParentCompany;
  if $Parent != empty then
    $Top = call microflow Partners.SUB_Partner_GetCommercialPartner(Partner = $Parent);
    if $Parent = $Partner or $Top = $Partner then
      validation feedback $Partner/Partners.Partner_ParentCompany message 'A contact cannot belong to itself.';
      set $IsValid = false;
    end if;
  end if;
  return $IsValid;
end;
-- ── replay: 502-partners-mf-partner-get-address
-- 502-partners-mf-partner-get-address.mdl — build-plan row 34 (F001). Owns Partners.SUB_Partner_GetAddress.

/**
 * The child address of a type (Invoice / Delivery) of a partner's company, or the company itself when it has none
 * (Odoo address_get). Used for an order's invoice and delivery addresses.
 *
 * @param $Partner the customer or vendor as chosen on a document
 * @param $AddressType Invoice or Delivery
 * @returns the address partner
 */
create or modify microflow Partners.SUB_Partner_GetAddress ($Partner: Partners.Partner, $AddressType: Enumeration(Partners.ENUM_AddressType))
returns Partners.Partner as $Address
folder 'Contacts/Microflows'
begin
  $Commercial = call microflow Partners.SUB_Partner_GetCommercialPartner(Partner = $Partner);
  if $Commercial = empty then
    return empty;
  end if;
  retrieve $Child from Partners.Partner
    where [Partners.Partner_ParentCompany = $Commercial][AddressType = $AddressType][Active = true] first;
  if $Child != empty then
    return $Child;
  end if;
  return $Commercial;
end;
-- ── replay: 503-partners-mf-partner-save
-- 503-partners-mf-partner-save.mdl — build-plan row 35 (F001-UC001, UC003). Owns Partners.SUB_Partner_Save,
-- SUB_Partner_Archive, ACT_Partner_Save, ACT_Partner_Archive. (New = the list's create-object action; children: generated ACT_Partner_AddTo*.)
-- Supersedes the walking skeleton's versions (mdlsource/_oneoff/2026-10-14-walking-skeleton.mdl).

/**
 * Persist a validated partner. A child contact or address inherits customer/vendor flags from its company,
 * so it can be picked on the same documents (F001 hidden rule).
 *
 * @param $Partner the partner
 */
create or modify microflow Partners.SUB_Partner_Save ($Partner: Partners.Partner)
folder 'Contacts/Microflows'
begin
  retrieve $Parent from $Partner/Partners.Partner_ParentCompany;
  if $Parent != empty then
    change $Partner (IsCustomer = $Parent/IsCustomer, IsVendor = $Parent/IsVendor);
  end if;
  commit $Partner with events refresh;
end;

/** Deactivate a partner: it leaves the pick lists, stays on existing documents (F001-UC003). */
create or modify microflow Partners.SUB_Partner_Archive ($Partner: Partners.Partner)
folder 'Contacts/Microflows'
begin
  change $Partner (Active = false);
  commit $Partner with events refresh;
end;

/**
 * Save button on the contact forms: validate, persist, close.
 *
 * @param $Partner the partner being edited
 * @returns true when saved
 */
create or modify microflow Partners.ACT_Partner_Save ($Partner: Partners.Partner)
returns Boolean as $Saved
folder 'Contacts/Microflows'
begin
  $IsValid = call microflow Partners.VAL_Partner(Partner = $Partner);
  if $IsValid then
    call microflow Partners.SUB_Partner_Save(Partner = $Partner);
    close page;
    return true;
  end if;
  return false;
end;

/** Archive button on the contact form. */
create or modify microflow Partners.ACT_Partner_Archive ($Partner: Partners.Partner)
folder 'Contacts/Microflows'
begin
  call microflow Partners.SUB_Partner_Archive(Partner = $Partner);
  close page;
end;
-- ── replay: 507-partners-page-partner-child-new-edit
