/** Contacts — Partner_Overview. */
create or modify page Partners.Partner_Overview folder 'Contacts/Pages'
(
  Title: 'Contacts',
  Layout: Core.App_Default,
  Url: 'partner-overview'
)
{
  container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
    container ctnPageHeadTitle (Class: 'page-head-title') {
      dynamictext txtTitle (Content: 'Contacts', RenderMode: H1)
    }
    container ctnPageHeadActions (Class: 'page-head-actions') {
      actionbutton btnNew (Caption: 'New', Action: create object Partners."Partner" then show page Partners.Partner_NewEdit, ButtonStyle: Primary)
    }
  }
  datagrid gridMain (DataSource: database Partners."Partner" sort by "Name" asc, PagingPosition: bottom, Class: 'density-compact', OnClick: show page Partners.Partner_NewEdit(Partner = $currentObject)) {
    column (Attribute: "Name", Caption: 'Name') { textfilter fName }
    column (Attribute: "Email", Caption: 'Email') { textfilter fEmail }
    column (Attribute: "Phone", Caption: 'Phone') { textfilter fPhone }
    column (Attribute: "City", Caption: 'City') { textfilter fCity }
    column (Attribute: Partner_Country/Name, Caption: 'Country')
    column (Attribute: "IsCustomer", Caption: 'Is customer') { dropdownfilter fIsCustomer }
    column (Attribute: "IsVendor", Caption: 'Is vendor') { dropdownfilter fIsVendor }
    column (Attribute: Partner_Salesperson/FullName, Caption: 'Salesperson')
  }
};

grant view on page Partners.Partner_Overview to Partners.Editor, Partners.Admin;
