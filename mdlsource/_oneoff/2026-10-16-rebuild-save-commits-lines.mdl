/** A new ReorderRule row, committed so the list shows it at once. */
create or modify microflow Inventory.SUB_ReorderRule_Add ()
returns Inventory.ReorderRule as $Row
folder 'Replenishment/Microflows'
begin
  $Row = create Inventory."ReorderRule" ();
  commit $Row refresh;
  return $Row;
end;

/** "+ Add a line" on ReorderRule_Overview. */
create or modify microflow Inventory.ACT_ReorderRule_Add ()
folder 'Replenishment/Microflows'
begin
  $Row = call microflow Inventory.SUB_ReorderRule_Add();
end;

