-- ── replay: mdlsource/8-inventory/811-inventory-page-warehouse-edit.mdl
-- GENERATED by pipelines/odoo/mdl_pages.py from ui_spec.py["Warehouse_Edit"] — wireframe design/wireframes/Warehouse_Edit.html.
-- Regenerate, do not hand-edit. Reached from: menu Configuration › Warehouse.

/** Validate a Warehouse before save: every required field on Warehouse_Edit, all flagged on one submit. */
create or modify microflow Inventory.VAL_Warehouse ($Warehouse: Inventory.Warehouse)
returns Boolean as $IsValid
folder 'Configuration/Microflows'
begin
  declare $IsValid Boolean = true;
  if $Warehouse/ShortName = empty or trim($Warehouse/ShortName) = '' then
    validation feedback $Warehouse/ShortName message 'Short name is required.';
    set $IsValid = false;
  end if;
  if $Warehouse/Inventory.Warehouse_StockLocation = empty then
    validation feedback $Warehouse/Inventory.Warehouse_StockLocation message 'Stock location is required.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated Warehouse. */
create or modify microflow Inventory.SUB_Warehouse_Save ($Warehouse: Inventory.Warehouse)
folder 'Configuration/Microflows'
begin
  retrieve $Lines0 from $Warehouse/Inventory.OperationType_Warehouse;
  commit $Lines0 with events;
  commit $Warehouse with events refresh;
end;

/** Save button on Warehouse_Edit: validate, persist, close. */
create or modify microflow Inventory.ACT_Warehouse_Save ($Warehouse: Inventory.Warehouse)
folder 'Configuration/Microflows'
begin
  $IsValid = call microflow Inventory.VAL_Warehouse(Warehouse = $Warehouse);
  if $IsValid then
    call microflow Inventory.SUB_Warehouse_Save(Warehouse = $Warehouse);
    close page;
  end if;
end;

/** A new OperationType on the Warehouse, committed so the line editor shows it at once. */
create or modify microflow Inventory.SUB_OperationType_Add ($Warehouse: Inventory.Warehouse)
returns Inventory.OperationType as $Line
folder 'Configuration/Microflows'
begin
  $Line = create Inventory."OperationType" (Inventory.OperationType_Warehouse = $Warehouse);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on Warehouse_Edit. */
create or modify microflow Inventory.ACT_OperationType_Add ($Warehouse: Inventory.Warehouse)
folder 'Configuration/Microflows'
begin
  $Line = call microflow Inventory.SUB_OperationType_Add(Warehouse = $Warehouse);
end;

/** Data source of Warehouse_Edit: DS_Warehouse_Get (the one warehouse). */
create or modify microflow Inventory.DS_Warehouse_Get ()
returns Inventory.Warehouse as $Warehouse
folder 'Configuration/Microflows'
begin
  retrieve $Warehouse from Inventory.Warehouse first;
  return $Warehouse;
end;

/** Warehouse — Warehouse_Edit. */
create or modify page Inventory.Warehouse_Edit folder 'Configuration/Pages'
(
  Title: 'Warehouse',
  Layout: Core.App_Default,
  Url: 'warehouse-edit'
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: microflow Inventory.DS_Warehouse_Get) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Warehouse', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Name = empty or trim($currentObject/Name) = '' then 'New' else $currentObject/Name), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Inventory.ACT_Warehouse_Save(Warehouse = $currentObject), ButtonStyle: Primary)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          dynamictext hWarehouse (Content: 'Warehouse', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
          textbox txtShortName (Label: 'Short name', Attribute: "ShortName")
          combobox cmbWarehouseAddress (Label: 'Address', Attribute: Warehouse_Address, DataSource: database Partners."Partner" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbWarehouseStockLocation (Label: 'Stock location', Attribute: Warehouse_StockLocation, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name")
        }
      }
    }
    dynamictext hOperationtypes (Content: 'Operation types', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 3) { dynamictext hdName (Content: 'Name', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdKind (Content: 'Kind', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdSequenceCode (Content: 'Sequence code', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdOperationTypeDefaultSource (Content: 'Default source', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdOperationTypeDefaultDestination (Content: 'Default destination', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdCreateBackorder (Content: 'Create backorder', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Inventory.OperationType_Warehouse, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { textbox lntxtName (Label: 'Name', Attribute: "Name") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbKind (Label: 'Kind', Attribute: "Kind") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { textbox lntxtSequenceCode (Label: 'Sequence code', Attribute: "SequenceCode") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbOperationTypeDefaultSource (Label: 'Default source', Attribute: OperationType_DefaultSource, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbOperationTypeDefaultDestination (Label: 'Default destination', Attribute: OperationType_DefaultDestination, DataSource: database Inventory."Location" sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { checkbox lncbCreateBackorder (Label: 'Create backorder', Attribute: "CreateBackorder") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Inventory.ACT_OperationType_Add(Warehouse = $currentObject))
  }
      }
    }
  }
};

