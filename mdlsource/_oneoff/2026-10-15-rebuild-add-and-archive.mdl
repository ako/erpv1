          combobox cmbBillPolicy (Label: 'Bill policy', Attribute: "BillPolicy")
          combobox cmbProductPurchaseUoM (Label: 'Purchase unit', Attribute: Product_PurchaseUoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name")
          textarea taPurchaseDescription (Label: 'Purchase description', Attribute: "PurchaseDescription")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hInventory (Content: 'Inventory', RenderMode: H2)
          combobox cmbProductUoM (Label: 'Unit', Attribute: Product_UoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtWeight (Label: 'Weight', Attribute: "Weight", DecimalPrecision: 2, GroupDigits: true)
          textbox txtVolume (Label: 'Volume', Attribute: "Volume", DecimalPrecision: 2, GroupDigits: true)
        }
      }
    }
    textarea taInternalNotes (Label: 'Internal notes', Attribute: "InternalNotes")
  }
      }
    }
  }
};

grant view on page Products.Product_NewEdit to Products.Manager;
grant execute on microflow Products.ACT_Product_Archive to Products.Manager;
grant execute on microflow Products.ACT_Product_Save to Products.Manager;
