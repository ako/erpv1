/** Odoo's checks on a Pricelist and its lines (BRD odooConstraints / odooChecks, disposition val). */
create or modify microflow Products.VAL_Pricelist_Rules ($Pricelist: Products.Pricelist)
returns Boolean as $IsValid
folder 'Pricing/Microflows'
begin
  declare $IsValid Boolean = true;
  retrieve $Rules from $Pricelist/Products.PriceRule_Pricelist;
  $BadDates = find $Rules where $currentObject/ValidFrom != empty and $currentObject/ValidTo != empty and $currentObject/ValidTo < $currentObject/ValidFrom;
  if $BadDates != empty then
    validation feedback $BadDates/ValidTo message 'The end date of a price rule cannot be before its start date.';
    set $IsValid = false;
  end if;
  $NoCategory = find $Rules where $currentObject/AppliesTo = Products.ENUM_PriceRuleScope.ProductCategory and $currentObject/Products.PriceRule_Category = empty;
  if $NoCategory != empty then
    validation feedback $NoCategory/Products.PriceRule_Category message 'Choose the category this rule applies to.';
    set $IsValid = false;
  end if;
  $NoProduct = find $Rules where $currentObject/AppliesTo = Products.ENUM_PriceRuleScope.Product and $currentObject/Products.PriceRule_Product = empty;
  if $NoProduct != empty then
    validation feedback $NoProduct/Products.PriceRule_Product message 'Choose the product this rule applies to.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Validate a Pricelist before save: every required field on Pricelist_NewEdit, all flagged on one submit. */
create or modify microflow Products.VAL_Pricelist ($Pricelist: Products.Pricelist)
returns Boolean as $IsValid
folder 'Pricing/Microflows'
begin
  declare $IsValid Boolean = true;
  if $Pricelist/Name = empty or trim($Pricelist/Name) = '' then
    validation feedback $Pricelist/Name message 'Name is required.';
    set $IsValid = false;
  end if;
  if $Pricelist/Products.Pricelist_Currency = empty then
    validation feedback $Pricelist/Products.Pricelist_Currency message 'Currency is required.';
    set $IsValid = false;
  end if;
  $RulesValid = call microflow Products.VAL_Pricelist_Rules(Pricelist = $Pricelist);
  if not($RulesValid) then
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated Pricelist. */
create or modify microflow Products.SUB_Pricelist_Save ($Pricelist: Products.Pricelist)
folder 'Pricing/Microflows'
begin
  retrieve $Lines0 from $Pricelist/Products.PriceRule_Pricelist;
  commit $Lines0 with events;
  commit $Pricelist with events refresh;
end;

/** Save button on Pricelist_NewEdit: validate, persist, close. */
create or modify microflow Products.ACT_Pricelist_Save ($Pricelist: Products.Pricelist)
folder 'Pricing/Microflows'
begin
  $IsValid = call microflow Products.VAL_Pricelist(Pricelist = $Pricelist);
  if $IsValid then
    call microflow Products.SUB_Pricelist_Save(Pricelist = $Pricelist);
    close page;
