    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Sales.ACT_QuotationTemplateLine_Add(QuotationTemplate = $currentObject))
    textarea taTermsAndConditions (Label: 'Terms and conditions', Attribute: "TermsAndConditions")
  }
      }
    }
  }
};

grant view on page Sales.QuotationTemplate_NewEdit to Sales.Manager;
grant execute on microflow Sales.ACT_QuotationTemplateLine_Add to Sales.Manager;
grant execute on microflow Sales.ACT_QuotationTemplate_Save to Sales.Manager;
