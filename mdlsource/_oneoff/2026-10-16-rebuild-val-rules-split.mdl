/** Odoo's checks on a ProductCategory and its lines (BRD odooConstraints / odooChecks, disposition val). */
create or modify microflow Products.VAL_ProductCategory_Rules ($ProductCategory: Products.ProductCategory)
returns Boolean as $IsValid
folder 'Catalogue/Microflows'
begin
  declare $IsValid Boolean = true;
  retrieve $NewParent from $ProductCategory/Products.ProductCategory_Parent;
  if $NewParent != empty and ($NewParent = $ProductCategory or ($ProductCategory/FullName != empty and startsWith($NewParent/FullName, $ProductCategory/FullName + ' / '))) then
    validation feedback $ProductCategory/Products.ProductCategory_Parent message 'You cannot create recursive categories.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

