          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtMinQuantity (Label: 'Min quantity', Attribute: "MinQuantity", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbComputation (Label: 'Computation', Attribute: "Computation") }
