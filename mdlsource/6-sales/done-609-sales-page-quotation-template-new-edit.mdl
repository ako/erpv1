/** Validate a QuotationTemplate before save: every required field on QuotationTemplate_NewEdit, all flagged on one submit. */
create or modify microflow Sales.VAL_QuotationTemplate ($QuotationTemplate: Sales.QuotationTemplate)
returns Boolean as $IsValid
folder 'Templates/Microflows'
begin
  declare $IsValid Boolean = true;
  if $QuotationTemplate/Name = empty or trim($QuotationTemplate/Name) = '' then
    validation feedback $QuotationTemplate/Name message 'Name is required.';
    set $IsValid = false;
  end if;
  retrieve $TemplateLines from $QuotationTemplate/Sales.QuotationTemplateLine_Template;
  $NoProduct = find $TemplateLines where $currentObject/Sales.QuotationTemplateLine_Product = empty;
  if $NoProduct != empty then
    validation feedback $NoProduct/Sales.QuotationTemplateLine_Product message 'Every template line needs a product.';
    set $IsValid = false;
  end if;
  return $IsValid;
end;

/** Persist a validated QuotationTemplate. */
create or modify microflow Sales.SUB_QuotationTemplate_Save ($QuotationTemplate: Sales.QuotationTemplate)
folder 'Templates/Microflows'
begin
  retrieve $Lines0 from $QuotationTemplate/Sales.QuotationTemplateLine_Template;
  commit $Lines0 with events;
  commit $QuotationTemplate with events refresh;
end;

/** Save button on QuotationTemplate_NewEdit: validate, persist, close. */
create or modify microflow Sales.ACT_QuotationTemplate_Save ($QuotationTemplate: Sales.QuotationTemplate)
folder 'Templates/Microflows'
begin
  $IsValid = call microflow Sales.VAL_QuotationTemplate(QuotationTemplate = $QuotationTemplate);
  if $IsValid then
    call microflow Sales.SUB_QuotationTemplate_Save(QuotationTemplate = $QuotationTemplate);
    close page;
  end if;
end;

/** A new QuotationTemplateLine on the QuotationTemplate, committed so the line editor shows it at once. */
create or modify microflow Sales.SUB_QuotationTemplateLine_Add ($QuotationTemplate: Sales.QuotationTemplate)
returns Sales.QuotationTemplateLine as $Line
folder 'Templates/Microflows'
begin
  $Line = create Sales."QuotationTemplateLine" (Sales.QuotationTemplateLine_Template = $QuotationTemplate);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on QuotationTemplate_NewEdit. */
create or modify microflow Sales.ACT_QuotationTemplateLine_Add ($QuotationTemplate: Sales.QuotationTemplate)
folder 'Templates/Microflows'
begin
  $Line = call microflow Sales.SUB_QuotationTemplateLine_Add(QuotationTemplate = $QuotationTemplate);
end;

/** Quotation template — QuotationTemplate_NewEdit. */
create or modify page Sales.QuotationTemplate_NewEdit folder 'Templates/Pages'
(
  Params: ( $QuotationTemplate: Sales.QuotationTemplate ),
  Title: 'Quotation template',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $QuotationTemplate) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Quotation template', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Name = empty or trim($currentObject/Name) = '' then 'New' else $currentObject/Name), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnSave0 (Caption: 'Save', Action: call microflow Sales.ACT_QuotationTemplate_Save(QuotationTemplate = $currentObject), ButtonStyle: Primary)
      }
    }
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 12, TabletWidth: 12, PhoneWidth: 12) {
          dynamictext hTemplate (Content: 'Template', RenderMode: H2)
          textbox txtName (Label: 'Name', Attribute: "Name")
          textbox txtValidityDays (Label: 'Validity days', Attribute: "ValidityDays")
        }
      }
    }
    dynamictext hLines (Content: 'Lines', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 1) { dynamictext hdLineType (Content: 'Line type', RenderMode: Text) }
        column (DesktopWidth: 3) { dynamictext hdQuotationTemplateLineProduct (Content: 'Product', RenderMode: Text) }
        column (DesktopWidth: 3) { dynamictext hdDescription (Content: 'Description', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdQuantity (Content: 'Quantity', RenderMode: Text) }
        column (DesktopWidth: 3) { dynamictext hdQuotationTemplateLineUoM (Content: 'Unit', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Sales.QuotationTemplateLine_Template, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbLineType (Label: 'Line type', Attribute: "LineType") }
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbQuotationTemplateLineProduct (Label: 'Product', Attribute: QuotationTemplateLine_Product, DataSource: database Products."Product" where [Active = true()][CanBeSold = true()] sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { textarea lntaDescription (Label: 'Description', Attribute: "Description") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtQuantity (Label: 'Quantity', Attribute: "Quantity", DecimalPrecision: 2, GroupDigits: true) }
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbQuotationTemplateLineUoM (Label: 'Unit', Attribute: QuotationTemplateLine_UoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name") }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: delete) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Sales.ACT_QuotationTemplateLine_Add(QuotationTemplate = $currentObject))
    textarea taTermsAndConditions (Label: 'Terms and conditions', Attribute: "TermsAndConditions")
  }
      }
    }
  }
};

grant view on page Sales.QuotationTemplate_NewEdit to Sales.Manager;
grant execute on microflow Sales.ACT_QuotationTemplateLine_Add to Sales.Manager;
grant execute on microflow Sales.ACT_QuotationTemplate_Save to Sales.Manager;
