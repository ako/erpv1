/** Sales order — SalesOrder_View. */
create or modify page Sales.SalesOrder_View folder 'Quotations/Pages'
(
  Params: ( $SalesOrder: Sales.SalesOrder ),
  Title: 'Sales order',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $SalesOrder) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Sales order', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Number = empty or trim($currentObject/Number) = '' then 'New' else $currentObject/Number), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnCreateinvoice0 (Caption: 'Create invoice', Action: call microflow Invoicing.ACT_SalesOrder_CreateInvoice(SalesOrder = $currentObject), ButtonStyle: Primary, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.SalesOrder and $currentObject/InvoiceStatus = Core.ENUM_InvoiceStatus.ToInvoice)
      }
    }
    dynamictext txtStatus (Content: '{1}', ContentParams: ({1} = "Status"), Class: 'pill pill-info spacing-outer-bottom-medium')
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hCustomer (Content: 'Customer', RenderMode: H2)
          combobox cmbSalesOrderCustomer (Label: 'Customer', Attribute: SalesOrder_Customer, DataSource: database Partners."Partner" where [Active = true()][IsCustomer = true()] sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          combobox cmbSalesOrderInvoiceAddress (Label: 'Invoice address', Attribute: SalesOrder_InvoiceAddress, DataSource: database Partners."Partner" where [Active = true()] sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          combobox cmbSalesOrderDeliveryAddress (Label: 'Delivery address', Attribute: SalesOrder_DeliveryAddress, DataSource: database Partners."Partner" where [Active = true()] sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          combobox cmbSalesOrderQuotationTemplate (Label: 'Quotation template', Attribute: SalesOrder_QuotationTemplate, DataSource: database Sales."QuotationTemplate" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.Quotation or $currentObject/Status = Sales.ENUM_SalesOrderStatus.QuotationSent)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hTerms (Content: 'Terms', RenderMode: H2)
          datepicker dpExpirationDate (Label: 'Expiration date', Attribute: "ExpirationDate", Editable: Never)
          combobox cmbSalesOrderPricelist (Label: 'Pricelist', Attribute: SalesOrder_Pricelist, DataSource: database Products."Pricelist" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          combobox cmbSalesOrderPaymentTerm (Label: 'Payment term', Attribute: SalesOrder_PaymentTerm, DataSource: database Core."PaymentTerm" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          datepicker dpOrderDate (Label: 'Order date', Attribute: "OrderDate", Editable: Never)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hOtherinfo (Content: 'Other info', RenderMode: H2)
          combobox cmbSalesOrderSalesperson (Label: 'Salesperson', Attribute: SalesOrder_Salesperson, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName", Editable: Never)
          combobox cmbSalesOrderSalesTeam (Label: 'Sales team', Attribute: SalesOrder_SalesTeam, DataSource: database Sales."SalesTeam" sort by "Name" asc, CaptionAttribute: "Name", Editable: Never)
          textbox txtCustomerReference (Label: 'Customer reference', Attribute: "CustomerReference", Editable: Never)
          datepicker dpDeliveryDate (Label: 'Delivery date', Attribute: "DeliveryDate", Editable: Never)
          textbox txtSource (Label: 'Source', Attribute: "Source", Editable: Never)
          combobox cmbInvoiceStatus (Label: 'Invoice status', Attribute: "InvoiceStatus", Editable: Never)
          combobox cmbDeliveryStatus (Label: 'Delivery status', Attribute: "DeliveryStatus", Editable: Never)
          checkbox cbLocked (Label: 'Locked', Attribute: "Locked", Editable: Never)
        }
      }
    }
    dynamictext hOrderlines (Content: 'Order lines', RenderMode: H2)
    datagrid gridOrderlines (DataSource: database Sales."SalesOrderLine" where [Sales.SalesOrderLine_SalesOrder = '[%CurrentObject%]'], Class: 'density-compact') {
      column (Attribute: SalesOrderLine_Product/Name, Caption: 'Product', WrapText: true)
      column (Attribute: "Quantity", Caption: 'Quantity', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
      column (Attribute: "QuantityDelivered", Caption: 'Quantity delivered', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
      column (Attribute: SalesOrderLine_UoM/Name, Caption: 'Unit', WrapText: true)
      column (Attribute: "UnitPrice", Caption: 'Unit price', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
      column (Attribute: "DiscountPercent", Caption: 'Discount percent', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
      column (Attribute: "Subtotal", Caption: 'Subtotal', Alignment: right, DynamicCellClass: 'num-right', WrapText: true)
    }
    container ctnTotals (Class: 'spacing-outer-bottom-large') {
      textbox txtAmountUntaxed (Label: 'Amount untaxed', Attribute: "AmountUntaxed", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTax (Label: 'Amount tax', Attribute: "AmountTax", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTotal (Label: 'Amount total', Attribute: "AmountTotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
    }
    textarea taTermsAndConditions (Label: 'Terms and conditions', Attribute: "TermsAndConditions")
  }
      }
    }
  }
};

grant view on page Sales.SalesOrder_View to Sales.Reader;
