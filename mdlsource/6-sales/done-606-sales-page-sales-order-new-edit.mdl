/** A new SalesOrderLine on the SalesOrder, committed so the line editor shows it at once. */
create or modify microflow Sales.SUB_SalesOrderLine_Add ($SalesOrder: Sales.SalesOrder)
returns Sales.SalesOrderLine as $Line
folder 'Quotations/Microflows'
begin
  $Line = create Sales."SalesOrderLine" (Sales.SalesOrderLine_SalesOrder = $SalesOrder);
  commit $Line refresh;
  return $Line;
end;

/** "+ Add a line" on SalesOrder_NewEdit. */
create or modify microflow Sales.ACT_SalesOrderLine_Add ($SalesOrder: Sales.SalesOrder)
folder 'Quotations/Microflows'
begin
  $Line = call microflow Sales.SUB_SalesOrderLine_Add(SalesOrder = $SalesOrder);
end;

/** Sales order — SalesOrder_NewEdit. */
create or modify page Sales.SalesOrder_NewEdit folder 'Quotations/Pages'
(
  Params: ( $SalesOrder: Sales.SalesOrder ),
  Title: 'Sales order',
  Layout: Core.App_Default
)
{
  layoutgrid gridPage {
    row {
      column (DesktopWidth: 12) {
  dataview dvMain (DataSource: $SalesOrder) {
    container ctnPageHead (Class: 'page-head spacing-outer-bottom-large') {
      container ctnPageHeadTitle (Class: 'page-head-title') {
        dynamictext txtCrumb (Content: 'Sales order', RenderMode: Text, Class: 'crumb')
        dynamictext txtTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/Number = empty or trim($currentObject/Number) = '' then 'New' else $currentObject/Number), RenderMode: H1)
      }
      container ctnPageHeadActions (Class: 'page-head-actions') {
        actionbutton btnCreateinvoice0 (Caption: 'Create invoice', Action: call microflow Invoicing.ACT_SalesOrder_CreateInvoice(SalesOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.SalesOrder)
        actionbutton btnSendmarkassent1 (Caption: 'Send (mark as sent)', Action: call microflow Sales.ACT_SalesOrder_MarkSent(SalesOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.Quotation)
        actionbutton btnConfirm2 (Caption: 'Confirm', Action: call microflow Sales.ACT_SalesOrder_Confirm(SalesOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.Quotation or $currentObject/Status = Sales.ENUM_SalesOrderStatus.QuotationSent)
        actionbutton btnCancelorder3 (Caption: 'Cancel order', Action: call microflow Sales.ACT_SalesOrder_Cancel(SalesOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.Quotation or $currentObject/Status = Sales.ENUM_SalesOrderStatus.QuotationSent or $currentObject/Status = Sales.ENUM_SalesOrderStatus.SalesOrder)
        actionbutton btnSettoquotation4 (Caption: 'Set to quotation', Action: call microflow Sales.ACT_SalesOrder_SetToQuotation(SalesOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.Cancelled)
        actionbutton btnLock5 (Caption: 'Lock', Action: call microflow Sales.ACT_SalesOrder_ToggleLock(SalesOrder = $currentObject), ButtonStyle: Default, Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.SalesOrder)
        actionbutton btnSave6 (Caption: 'Save', Action: call microflow Sales.ACT_SalesOrder_Save(SalesOrder = $currentObject), ButtonStyle: Primary)
      }
    }
    dynamictext txtStatus (Content: '{1}', ContentParams: ({1} = "Status"), Class: 'pill pill-info spacing-outer-bottom-medium')
    linkbutton lnkSmartDelivery (Caption: 'Delivery', Action: call microflow Inventory.ACT_SalesOrder_OpenDelivery(SalesOrder = $currentObject), Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.SalesOrder)
    layoutgrid gridSections (Class: 'spacing-outer-bottom-large') {
      row {
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hCustomer (Content: 'Customer', RenderMode: H2)
          combobox cmbSalesOrderCustomer (Label: 'Customer', Attribute: SalesOrder_Customer, DataSource: database Partners."Partner" where [Active = true()][IsCustomer = true()] sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Sales.ACT_SalesOrder_ChangeCustomer(SalesOrder = $currentObject))
          combobox cmbSalesOrderInvoiceAddress (Label: 'Invoice address', Attribute: SalesOrder_InvoiceAddress, DataSource: database Partners."Partner" where [Active = true()] sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbSalesOrderDeliveryAddress (Label: 'Delivery address', Attribute: SalesOrder_DeliveryAddress, DataSource: database Partners."Partner" where [Active = true()] sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbSalesOrderQuotationTemplate (Label: 'Quotation template', Attribute: SalesOrder_QuotationTemplate, DataSource: database Sales."QuotationTemplate" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Sales.ACT_SalesOrder_ApplyTemplate(SalesOrder = $currentObject), Visible: $currentObject/Status = Sales.ENUM_SalesOrderStatus.Quotation or $currentObject/Status = Sales.ENUM_SalesOrderStatus.QuotationSent)
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hTerms (Content: 'Terms', RenderMode: H2)
          datepicker dpExpirationDate (Label: 'Expiration date', Attribute: "ExpirationDate")
          combobox cmbSalesOrderPricelist (Label: 'Pricelist', Attribute: SalesOrder_Pricelist, DataSource: database Products."Pricelist" sort by "Name" asc, CaptionAttribute: "Name")
          combobox cmbSalesOrderPaymentTerm (Label: 'Payment term', Attribute: SalesOrder_PaymentTerm, DataSource: database Core."PaymentTerm" sort by "Name" asc, CaptionAttribute: "Name")
          datepicker dpOrderDate (Label: 'Order date', Attribute: "OrderDate")
        }
        column (DesktopWidth: 6, TabletWidth: 6, PhoneWidth: 12) {
          dynamictext hOtherinfo (Content: 'Other info', RenderMode: H2)
          combobox cmbSalesOrderSalesperson (Label: 'Salesperson', Attribute: SalesOrder_Salesperson, DataSource: database Administration."Account" sort by "FullName" asc, CaptionAttribute: "FullName")
          combobox cmbSalesOrderSalesTeam (Label: 'Sales team', Attribute: SalesOrder_SalesTeam, DataSource: database Sales."SalesTeam" sort by "Name" asc, CaptionAttribute: "Name")
          textbox txtCustomerReference (Label: 'Customer reference', Attribute: "CustomerReference")
          datepicker dpDeliveryDate (Label: 'Delivery date', Attribute: "DeliveryDate")
          textbox txtSource (Label: 'Source', Attribute: "Source")
          combobox cmbInvoiceStatus (Label: 'Invoice status', Attribute: "InvoiceStatus", Editable: Never)
          combobox cmbDeliveryStatus (Label: 'Delivery status', Attribute: "DeliveryStatus", Editable: Never)
          checkbox cbLocked (Label: 'Locked', Attribute: "Locked", Editable: Never)
        }
      }
    }
    dynamictext hOrderlines (Content: 'Order lines', RenderMode: H2)
    layoutgrid gridLinesHead (Class: 'th lines-head hide-phone') {
      row {
        column (DesktopWidth: 3) { dynamictext hdSalesOrderLineProduct (Content: 'Product', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdQuantity (Content: 'Quantity', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdQuantityDelivered (Content: 'Quantity delivered', RenderMode: Text) }
        column (DesktopWidth: 2) { dynamictext hdSalesOrderLineUoM (Content: 'Unit', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdUnitPrice (Content: 'Unit price', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdSalesOrderLineTaxes (Content: 'Taxes', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdDiscountPercent (Content: 'Discount percent', RenderMode: Text) }
        column (DesktopWidth: 1) { dynamictext hdSubtotal (Content: 'Subtotal', RenderMode: Text) }
      }
    }
    listview lvLines (DataSource: $currentObject/Sales.SalesOrderLine_SalesOrder, Editable: true, Class: 'lines-list') {
      layoutgrid gridLine {
        row {
          column (DesktopWidth: 3, TabletWidth: 3, PhoneWidth: 12) { combobox lncmbSalesOrderLineProduct (Label: 'Product', Attribute: SalesOrderLine_Product, DataSource: database Products."Product" where [Active = true()][CanBeSold = true()] sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Sales.ACT_SalesOrderLine_ChangeProduct(SalesOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtQuantity (Label: 'Quantity', Attribute: "Quantity", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Sales.ACT_SalesOrderLine_ChangeQuantity(SalesOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtQuantityDelivered (Label: 'Quantity delivered', Attribute: "QuantityDelivered", DecimalPrecision: 2, GroupDigits: true, Editable: Never) }
          column (DesktopWidth: 2, TabletWidth: 2, PhoneWidth: 12) { combobox lncmbSalesOrderLineUoM (Label: 'Unit', Attribute: SalesOrderLine_UoM, DataSource: database Products."UoM" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Sales.ACT_SalesOrderLine_ChangeUoM(SalesOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtUnitPrice (Label: 'Unit price', Attribute: "UnitPrice", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Sales.ACT_SalesOrderLine_ChangePrice(SalesOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { combobox lncmbSalesOrderLineTaxes (Label: 'Taxes', Attribute: SalesOrderLine_Taxes, DataSource: database Core."Tax" sort by "Name" asc, CaptionAttribute: "Name", OnChange: call microflow Sales.ACT_SalesOrderLine_Recompute(SalesOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtDiscountPercent (Label: 'Discount percent', Attribute: "DiscountPercent", DecimalPrecision: 2, GroupDigits: true, OnChange: call microflow Sales.ACT_SalesOrderLine_Recompute(SalesOrderLine = $currentObject)) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { textbox lntxtSubtotal (Label: 'Subtotal', Attribute: "Subtotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never) }
          column (DesktopWidth: 1, TabletWidth: 1, PhoneWidth: 12) { linkbutton btnLineDelete (Caption: 'Remove', Action: call microflow Sales.ACT_SalesOrderLine_Delete(SalesOrderLine = $currentObject)) }
        }
      }
    }
    linkbutton btnAddLine (Caption: '+ Add a line', Action: call microflow Sales.ACT_SalesOrderLine_Add(SalesOrder = $currentObject))
    container ctnTotals (Class: 'spacing-outer-bottom-large') {
      textbox txtAmountUntaxed (Label: 'Amount untaxed', Attribute: "AmountUntaxed", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTax (Label: 'Amount tax', Attribute: "AmountTax", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
      textbox txtAmountTotal (Label: 'Amount total', Attribute: "AmountTotal", DecimalPrecision: 2, GroupDigits: true, Editable: Never)
    }
    textarea taTermsAndConditions (Label: 'Terms and conditions', Attribute: "TermsAndConditions")
  }
      }
    }
  }
};

